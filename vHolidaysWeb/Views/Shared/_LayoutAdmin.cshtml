<body>
    <div class="preloader">
        <div class="preloader__image" style="background-image: url(/assets/images/preloader.gif);"></div>
    </div>
    <!-- ======= Header ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">

        <div class="d-flex align-items-center justify-content-between">
            <a href="/admin" class="logo d-flex align-items-center">
                <img src="~/assets/images/logo.svg" alt="">
                <span class="d-none d-lg-block">Vietjet Holidays</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div>


        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">
                <li class="nav-item dropdown pe-3">

                    <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
                        <img src="~/assets/images/testimonial/testimonials-1.jpg" alt="Profile" class="rounded-circle">
                        <span class="d-none d-md-block dropdown-toggle ps-2">@User.Identity.Name</span>
                    </a>
                    @{
                        var Roles = "Admin";
                        var userRoles = User.Claims
                        .Where(c => c.Type == ClaimTypes.Role)
                        .Select(c => c.Value)
                        .ToList();
                        if (userRoles.Any())
                        {
                            Roles = string.Join(", ", userRoles);

                        }
                    }
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
                        <li class="dropdown-header">
                            <h6>@User.Identity.Name</h6>
                            <span>
                                @Roles
                            </span>
                        </li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>


                        <li>
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/")" method="post">
                                <button type="submit" class="dropdown-item d-flex align-items-center">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>

    </header>

    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">

        <ul class="sidebar-nav" id="sidebar-nav">

            <li class="nav-item">
                <a class="nav-link " href="/Admin">
                    <i class="fa fa-th-large" aria-hidden="true"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Destination">
                    <i class="fa-solid fa-plane"></i>
                    <span>Destinations</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/MasterData/">
                    <i class="fa-solid fa-database"></i> <span>Master Data</span>
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Package">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Package</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link " href="~/Admin/GroupBooking">
                    <i class="fa-solid fa-people-group"></i>
                    <span>Group Departure</span>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Hotel">
                    <i class="fa-solid fa-hotel"></i>
                    <span>Hotel</span>
                </a>
            </li>


            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Booking/">
                    <i class="fa-solid fa-list-check"></i> <span>Bookings</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Tailortrip/">
                    <i class="fa-solid fa-umbrella-beach"></i> <span>Tailor Trip</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Vendor/">
                    <i class="fa-solid fa-boxes-packing"></i> <span>Vendor</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/ContactBranches">
                    <i class="fa-solid fa-gear"></i>
                    <span>Branches</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Contact">
                    <i class="fa-solid fa-phone"></i>
                    <span>Contacts</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/Contact/GetMessages">
                    <i class="fa-solid fa-message"></i> <span>Messages</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="/Admin/Region/AddRegions">
                    <i class="fa-solid fa-message"></i> <span>Add Region</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="~/Admin/region/index">
                    <i class="fa-solid fa-globe"></i> <span>Cities</span>
                </a>
            </li>
        </ul>
    </aside>

    <main id="main" class="main">
        @RenderBody()
    </main>

     <!-- ======= Footer ======= -->
    <footer id="footer" class="footer">
    </footer>

    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
    <script src="~/assets/vendors/jquery/jquery-3.7.0.min.js"></script>
