    <!-- Template Main JS File -->
    <script src="~/assets/js/main.js"></script>
    <script src="~/pagescripts/common/shared.js"></script>
    <script>
        Dropzone.autoDiscover = false;
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


