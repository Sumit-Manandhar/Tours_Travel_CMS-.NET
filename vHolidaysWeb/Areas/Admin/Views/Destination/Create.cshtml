@using vHolidays.Models.Destinations.DataTransferObjects
@model DestinationAddUpdateModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if(Model.Id== 0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        ViewData["Title"] = "Add";
    }
    else
    {
        ViewData["Title"] = "Edit";

    }

}
@section Styles {
    <style>
        .image-container {
            position: relative;
            width: 300px;
            border-radius: 20px;
            overflow: hidden;
        }

            .image-container img {
                width: 100%;
                height: auto;
                border-radius: 20px;
            }
    </style>
}
<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Destinations</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Destination",new {Area="Admin"})">Destinations</a></li>
            <li class="breadcrumb-item active"> @ViewData["Title"]</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="CreateUpdateDestination" asp-controller="Destination" method="post" id="createDestinationForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />

                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Country</label>
                            @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countries, "Id", "CountryName"),
                                     new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Short Description</label>
                            <input type="text" asp-for="ShortDescription" class="form-control" placeholder="Short Description">
                            @Html.ValidationMessageFor(model => model.ShortDescription, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Description</label>
                            <textarea class="form-control" asp-for="Description"> </textarea>
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Overview</label>
                            <textarea class="form-control" asp-for="Overview" name="Overview" placeholder="Overview"> </textarea>
                        </div>

                        <div class="col-md-6">
                            <div class="image-container" >
                                <img src="@(Model.BaseUrl+Model?.BannerImgUrl??"")"  id="img-banner" alt="Banner Img"
                                >
                            </div>
                            <label for="inputText" class="col-sm-6 col-form-label">Banner Image</label>
                            <input type="file" asp-for="BannerImg" class="form-control" />
                            <input type="hidden" asp-for="BannerImgUrl" class="form-control" />
                        </div>

                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <a href="@Url.Action("Index", "Destination", new { Area = "Admin"})" class="btn btn-secondary">Back</a>
                        <button type="Button" id="btn-addsubs"  class="btn btn-primary">Submit & Add Sub-Destinations</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/destination/createdestination.js"></script>
    <script>
        var cd = new CreateDestination();
        cd.init();
    </script>
}