@using vHolidays.Utility.Enumerations
@model int
@{
    Layout = null;
    var selected = (PackageTabMenu)Model;
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var controller = IsGroupBooking ? "GroupBooking" : "Package";

    var detailUrl = Url.Action("Edit", controller, new { Id = ViewData["PackageDetailId"] });
    var inclusionUrl = Url.Action("Inclusion", controller, new { Id = ViewData["PackageDetailId"] });
    var itineraryUrl = Url.Action("Itinerary", controller, new { Id = ViewData["PackageDetailId"] });
    var imagesUrl = Url.Action("Images", controller, new { Id = ViewData["PackageDetailId"] });
    var hotelUrl = Url.Action("Hotels", controller, new { Id = ViewData["PackageDetailId"] });
    var GroupUrl = Url.Action("PackageGroup", controller, new { Id = ViewData["PackageDetailId"] });
    var PriceUrl = Url.Action("Price", controller, new { Id = ViewData["PackageDetailId"] });
    var FlightUrl = Url.Action("Flights", controller, new { Id = ViewData["PackageDetailId"] });
}

<ul class="nav nav-tabs pt-3" id="packageTab" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Detail ? "active" : "")" id="Detail-tab" data-bs-target="#Detail" aria-controls="Detail"
           href="@detailUrl" @(selected == PackageTabMenu.Detail ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Detail
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Inclusion ? "active" : "")" id="Inclusion-tab" data-bs-target="#Inclusion" aria-controls="Inclusion"
           href="@inclusionUrl" @(selected == PackageTabMenu.Inclusion ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Inclusion
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Itinerary ? "active" : "")" id="Itinerary-tab" data-bs-target="#Itinerary" aria-controls="Itinerary"
           href="@itineraryUrl" @(selected == PackageTabMenu.Itinerary ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Itinerary
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Hotel ? "active" : "")" id="Images-tab" data-bs-target="#Hotels" aria-controls="Hotels"
           href="@hotelUrl" @(selected == PackageTabMenu.Hotel ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Hotels
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Group ? "active" : "")" id="Group-tab" data-bs-target="#Group" aria-controls="Group"
           href="@GroupUrl" @(selected == PackageTabMenu.Group ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Group
        </a>
    </li>

    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Price ? "active" : "")" id="Price-tab" data-bs-target="#Price" aria-controls="Price"
           href="@PriceUrl" @(selected == PackageTabMenu.Price ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Price
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Images ? "active" : "")" id="Images-tab" data-bs-target="#Images" aria-controls="Images"
           href="@imagesUrl" @(selected == PackageTabMenu.Images ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Images
        </a>
    </li> 
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == PackageTabMenu.Flights ? "active" : "")" id="Flight-tab" data-bs-target="#Flights" aria-controls="Flights"
           href="@FlightUrl" @(selected == PackageTabMenu.Flights ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Flights
        </a>
    </li>
</ul>