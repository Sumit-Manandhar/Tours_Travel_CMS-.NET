@using vHolidays.Models.Package.DataTransferObjects
@model List<PackageFlightAddUpdateModel>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    ViewData["Title"] = "AddUpdateItinerary";
    var PackageDetailId = (int)ViewData["PackageDetailId"];
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var controller = IsGroupBooking ? "GroupBooking" : "Package";
    var displayText = IsGroupBooking ? "Group Booking" : "Package";
}
<style>
    label.error {
        color: red;
    }
</style>
<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@displayText- Add/Edit Flights</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index",controller,new {Area="Admin"})">@displayText</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Flights",controller,new {Area="Admin",id=PackageDetailId})">Flights</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" asp-controller="Package" method="post" id="saveItineraryForm">
                    <input type="hidden" name="PackageDetailId" value="@PackageDetailId" />

                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-top:20px">
                                    <table class="table customize-table table-bordered mb-0 v-middle" id="tblItti">
                                        <thead class="table-light">
                                            <tr>
                                                <td>Origin</td>
                                                <td>Destination</td>
                                                <td>Flight Number</td>
                                                <td>Flight PNR</td>
                                                <td>Departure Date</td>
                                                <td>Return date</td>
                                                <td>Is Return</td>
                                                <td>Is Multi city</td>
                                                @*  <td>State</td> *@
                                                <td>Action</td>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            @if (Model.Count > 0)
                                            {
                                                var ct = 0;
                                                @foreach (var i in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <input  type="hidden" name="Flights[@ct].Id" value="@i.Id"/>
                                                            <input type="text" name="Flights[@ct].Origin" id="Flights[@ct].Origin" class="form-control" Value="@(i.Origin)" placeholder="Origin" required />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="Flights[@ct].Destination" id="Flights[@ct].Destination" class="form-control" Value="@(i.Destination)" placeholder="Destination" required />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="Flights[@ct].FlightNumber" id="Flights[@ct].FlightNumber" class="form-control " Value="@i.FlightNumber" placeholder="Flight Number" required />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="Flights[@ct].PNRNumber" id="Flights[@ct].PNRNumber" class="form-control " Value="@i.PNRNumber" placeholder="PNRNumber" required />
                                                        </td>
                                                        <td>
                                                            <input type="datetime-local" name="Flights[@ct].DepartureDate" id="Flights[@ct].DepartureDate" class="form-control " Value="@i.DepartureDate.ToString("yyyy-MM-ddTHH:mm")" required />
                                                        </td>
                                                        <td>
                                                            @{
                                                                DateTime returnDate ;
                                                                if (i.ReturnDate.HasValue)
                                                                {
                                                                    <input type="datetime-local" name="Flights[@ct].ReturnDate" id="Flights[@ct].ReturnDate" class="form-control " Value="@i.ReturnDate.Value.ToString("yyyy-MM-ddTHH:mm")" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="datetime-local" name="Flights[@ct].ReturnDate" id="Flights[@ct].ReturnDate" class="form-control " />

                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            <select name="Flights[@ct].IsReturn" class="form-control">
                                                                <option value="True" selected="@i.IsReturn"> Yes </option>
                                                                <option value="False" selected="@(!i.IsReturn)"> No </option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <select name="Flights[@ct].IsMultiCity" class="form-control">
                                                                <option value="True" selected="@i.IsMultiCity"> Yes </option>
                                                                <option value="False" selected="@(!i.IsMultiCity)"> No </option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-danger btn-sm" data-action="delete-row" >
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </td>

                                                    </tr>
                                                    ct++;
                                                }
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td>
                                                    <input type="text" name="AC.Origin" id="AC.Origin" class="form-control" placeholder="Origin" required />
                                                </td>
                                                <td>
                                                    <input type="text" name="AC.Destination" id="AC.Destination" class="form-control" placeholder="Destination" required />
                                                </td>
                                                <td>
                                                    <input type="text" name="AC.FlightNumber" id="AC.FlightNumber" class="form-control " placeholder="Flight Number" required />
                                                </td>
                                                <td>
                                                    <input type="text" name="AC.PNRNumber" id="AC.PNRNumber" class="form-control " placeholder="PNRNumber" required />
                                                </td>
                                                <td>
                                                    <input type="datetime-local" name="AC.DepartureDate" id="AC.DepartureDate" class="form-control " placeholder="" required />
                                                </td>
                                                <td>
                                                    <input type="datetime-local" name="AC.ReturnDate" id="AC.DepartureDate" class="form-control " placeholder="" />
                                                </td>
                                                <td>
                                                    <select name="AC.IsReturn" class="form-control ">
                                                       <option value="True"> Yes </option>
                                                        <option value="False"> No </option>
                                                   </select>
                                                </td>
                                                <td>
                                                    <select name="AC.IsMultiCity" class="form-control ">
                                                        <option value="True"> Yes </option>
                                                        <option value="False"> No </option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-danger btn-sm" data-action="add-row">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-sm" data-action="delete-row" style="display:none;">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>

                                            </tr>



                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3">
                        <button type="button" id="addUpdateItinerary" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Flights",controller,new {Area="Admin",id=PackageDetailId})'">Back</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/js/tableform.js"></script>
    <script src="~/pagescripts/admin/package/addflight.js"></script>
    <script>
        var pi = new PackageFlight();
        pi.init();
    </script>
}