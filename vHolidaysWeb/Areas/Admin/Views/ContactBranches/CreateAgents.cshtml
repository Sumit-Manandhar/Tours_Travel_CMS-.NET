@using vHolidays.Models.Settings.DataTransferObjects;
@model AgentsDTO
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if (Model.Id == 0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        ViewData["Title"] = "Add";
    }
    else
        ViewData["Title"] = "Edit";

}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Add Agents</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/ContactBranches">Branches</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/ContactBranches/Agents/@Model.ContactBranchId">Agents</a> </li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="SaveAgents" asp-controller="Contact" method="post" id="UpdateAgentForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <input type="hidden" asp-for="ContactBranchId" class="form-control" />
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Name</label>
                            <input type="text" asp-for="AgentName" class="form-control" placeholder="Agent Name">
                            @Html.ValidationMessageFor(model => model.AgentName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Liscence Number</label>
                            <input type="text" asp-for="LiscenceNo" class="form-control" placeholder="Liscence No.">
                            @Html.ValidationMessageFor(model => model.LiscenceNo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Contact Email</label>
                            <input type="text" asp-for="Email" class="form-control" placeholder="Contact Email">
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-6 col-form-label">Address</label>
                            <input type="text" asp-for="Address" class="form-control" placeholder="Contact Address">
                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                        </div>
                        

                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>



                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/contacts/createagents.js"></script>
    <script>
        var cd = new CreateAgents();
        cd.ContactBranchId=@Model.ContactBranchId;
        cd.init();
    </script>
}
