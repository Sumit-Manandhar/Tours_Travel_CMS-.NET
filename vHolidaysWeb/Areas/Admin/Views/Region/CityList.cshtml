@using vHolidays.Models.Regions.DataTransferObject
@model CityPaginationModel
@{
    Layout = null;
}

<div class="col-lg-12">
    <div class="row">
        @Html.RenderPageSize("pageSize", Model.PageSize)
        <div class="col-md-12">
            <div class="table-responsive">
                <table class="table customize-table table-bordered mb-0 v-middle">
                    <thead class="table-light">
                        <tr>
                            <th>
                                Id
                            </th>
                            <th>
                               
                                    City Name
                                
                            </th>
                            <th>
                                
                                    Country
                            
                            </th>
                            <th>
                               
                                   Is Active
                                
                            </th>
                            <th>
                                
                                    Is Deleted
                               
                            </th>

                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cities != null && Model.Cities.Any())
                        {
                            foreach (var data in Model.Cities)
                            {

                                <tr >
                                    <td>@data.Id</td>
                                    <td>@data.CityName</td>
                                    <td>@data.CountryName</td>
                                    <td>@data.isActive</td>
                                    <td>@data.IsDelete</td>
                                    <td>
                                        <div class="dropdown dropstart">
                                            <a href="javascript:void(0);" class="link" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fa-solid fa-ellipsis"></i>
                                            </a>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                                <li>
                                                    <a class="dropdown-item text-black" data-type="Edit" data-id="@data.Id"><i class="fa fa-pen"> </i> Edit </a>
                                                </li>
                                                @if(data.IsDelete)
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-black" data-type="Delete" data-id="@data.Id"><i class="fa fa-trash-arrow-up"> </i> Restore </a>
                                                    </li>
                                                }

                                                else
                                                {
                                                    <li>
                                                        <a class="dropdown-item text-black" data-type="Delete" data-id="@data.Id"><i class="fa fa-trash-can"> </i> Delete </a>
                                                    </li>
                                                }


                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-center" colspan="6">
                                    No data found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            @Html.RenderPager2(Model.PageNum, Model.TotalPage)
            @Html.RenderPageInfo(Model.PageNum, Model.PageSize, Model.TotalRows)
            @Html.Hidden("pageNum", Model.PageNum)
            @Html.Hidden("pageCount", Model.TotalPage)
        </div>
    </div>
</div>