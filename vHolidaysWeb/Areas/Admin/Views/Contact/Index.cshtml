@using vHolidays.Models.Settings;
@model Contacts
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Contacts";
    if (Model.Id == 0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        Model.IsDeleted = false;
    }

}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Contacts</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item active">Contacts</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="UpdateContact" asp-controller="Contact" method="post" id="UpdateContactForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        

                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Contact Number</label>
                            <input type="text" asp-for="ContactNumber" class="form-control" placeholder="Contact Number">
                            @Html.ValidationMessageFor(model => model.ContactNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Contact Email</label>
                            <input type="text" asp-for="ContactEmail" class="form-control" placeholder="Contact Email">
                            @Html.ValidationMessageFor(model => model.ContactEmail, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Address</label>
                            <input type="text" asp-for="ContactAddress" class="form-control" placeholder="Contact Address">
                            @Html.ValidationMessageFor(model => model.ContactAddress, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Latitude</label>
                            <input type="text" asp-for="ContactEmail" class="form-control" placeholder="latitude">
                            @Html.ValidationMessageFor(model => model.Latitude, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Longitude</label>
                            <input type="text" asp-for="Longitude" class="form-control" placeholder="longitude">
                            @Html.ValidationMessageFor(model => model.Longitude, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Link for Map</label>
                            <textarea class="form-control" asp-for="MapLinks"  placeholder="Link for map"> </textarea>
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Link for facebook</label>
                            <textarea class="form-control" asp-for="FacebookLink" placeholder="Link for facebook"> </textarea>
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Link for instagram</label>
                            <textarea class="form-control" asp-for="InstagramLink" placeholder="Link for Instagram"> </textarea>
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Link for Twitter</label>
                            <textarea class="form-control" asp-for="TwitterLink" placeholder="Link for Twitter"> </textarea>
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-2 col-form-label">Link for Youtube</label>
                            <textarea class="form-control" asp-for="YoutubeLink" placeholder="Link for Youtube"> </textarea>
                        </div>
                        

                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/contacts/create.js"></script>
    <script>
        var cd = new contacts();
        cd.init();
    </script>
}