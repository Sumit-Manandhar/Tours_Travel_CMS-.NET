@using vHolidays.Models.Package.DataTransferObjects
@using vHolidays.Utility.Extensions
@model PackageDetailViewModel
@{

    ViewData["Title"] = "Detail";
    var defaultImg = "assets/images/tours/tour-3-5.jpg";
    var backGroundImg = "/" + (string.IsNullOrWhiteSpace(Model.ImgUrl) ? defaultImg : Model.ImgUrl);
    var route = Model.IsGroupBooking ? "/Customer/Package/Group" : "/Customer/Package";
    var displayText = Model.IsGroupBooking ? "Group Booking" : "Package";
}

<section class="page-header">
    <div class="page-header__bg page-header__bg-packages" style="background-image: url('@backGroundImg');"></div>
    <div class="container">
        <h2 class="page-header__title wow animated fadeInLeft" data-wow-delay="0s" data-wow-duration="1500ms">@Model.Day Days @Model.Night Nights @Model.Name | @Model.Code </h2>
        <div class="page-header__breadcrumb-box">
            <ul class="vietjet-breadcrumb">
                <li><a href="/">Home</a></li>
                <li><a href="@route">@displayText</a></li>
                <li>@Model.Code</li>
            </ul>
        </div>
    </div>
    <div class="next-prev-pack">
        @if (Model.PreviousId.HasValue && Model.PreviousId.Value > 0)
        {
            <a class="btn vietjet-btn prev" href="@Url.Action("Detail","Package", new{ Area="Customer", id=Model.PreviousId.Value})" title="Previous Package"><i class="icon-left-arrow"></i></a>
        }
        @if (Model.NextId.HasValue && Model.NextId.Value > 0)
        {
            <a class="btn vietjet-btn next" href="@Url.Action("Detail","Package", new{ Area="Customer", id=Model.NextId.Value})" title="Next Package"><i class="icon-right-arrow"></i></a>
        }

    </div>
</section>

<section class="tour-listing-details tour-listing-details-right">
    <div class="tour-listing-details__destination">
        <div class="container">
            <div class="tour-listing-details__destination-row row">
                <div class="col-xl-4 wow animated fadeInLeft" data-wow-delay="0.1s" data-wow-duration="1500ms">
                    <div class="tour-listing-details__destination-left">
                        <h3 class="tour-listing-details__dastination-title">@Model.Code </h3>
                        @Html.HiddenFor(x => x.Id)
                        @* <h4 class="tour-listing-details__dastination-price"><span>$130</span><span class="tour-listing-details__dastination-person">/ Per Person</span></h4> *@
                    </div>
                </div>
                <div class="col-xl-8">
                    <div class="tour-listing-details__destination-right">
                        <div class="tour-listing-details__destination-info wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            <span class="icon-clock-1"></span>
                            <div class="tour-listing-details__destination-info-title">
                                <h4 class="tour-listing-details__destination-info-top">Duration</h4>
                                <h4 class="tour-listing-details__destination-info-bottom">@Model.Day Days / @Model.Night Nights</h4>
                            </div>
                        </div>
                        @if (Model.IsGroupBooking)
                        {
                            <div class="tour-listing-details__destination-info wow animated fadeInUp" data-wow-delay="0.3s" data-wow-duration="1500ms">
                                <span class="icon-calendar-5"></span>
                                <div class="tour-listing-details__destination-info-title">
                                    <h4 class="tour-listing-details__destination-info-top">Date</h4>
                                    <h4 class="tour-listing-details__destination-info-bottom">@Model.StartDate.ddMMyyyy()</h4>
                                </div>
                            </div>
                        }
                        @if (Model.PackageTypes is not null && Model.PackageTypes.Count > 0)
                        {
                            <div class="tour-listing-details__destination-info wow animated fadeInUp" data-wow-delay="0.5s" data-wow-duration="1500ms">
                                <span class="icon-plane"></span>
                                <div class="tour-listing-details__destination-info-title">
                                    <h4 class="tour-listing-details__destination-info-top">Tour Type</h4>
                                    <h4 class="tour-listing-details__destination-info-bottom">
                                        @(string.Join(", ", Model.PackageTypes.Select(a => a.Name).ToArray()))
                                    </h4>
                                </div>
                            </div>
                        }

                        <div class="tour-listing-details__destination-info wow animated fadeInUp" data-wow-delay="0.7s" data-wow-duration="1500ms">
                            <span class="icon-location-1"></span>
                            <div class="tour-listing-details__destination-info-title">
                                <h4 class="tour-listing-details__destination-info-top">Location</h4>
                                <h4 class="tour-listing-details__destination-info-bottom">@Model.Country</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-xl-8">
                <div class="tour-listing-details__slider">
                    @{
                        var carouselSettings = new
                        {
                            Items = 2,
                            Margin = 30,
                            SmartSpeed = 700,
                            Loop = false,
                            Autoplay = 6000,
                            Nav = false,
                            Dots = true,
                            NavText = new string[] { "<span class=\"fa fa-angle-left\"></span>", "<span class=\"fa fa-angle-right\"></span>" },
                            Responsive = new { _0 = new { Items = 1 }, _768 = new { Items = 2 } }
                        };
                    }
                    <div class="tour-listing-details__carousel vietjet-owl__carousel vietjet-owl__carousel--basic-nav owl-theme owl-carousel" data-owl-options='@Json.Serialize(carouselSettings)'>
                        @foreach (var img in Model.Images)
                        {
                            var imgUrl = "/" + img;
                            <div class="tour-listing-details__carousel-item item">
                                <div class="tour-listing-details__carousel-image-box">
                                    <img src="@imgUrl" alt="tour-listing-details-slide" class="tour-listing-details__carousel-image">
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tour-listing-details__explore" style="text-align: justify;">
                    <div class="wow animated fadeIn" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <h3 class="tour-listing-details__title tour-listing-details__explore-title">Explore Tours</h3>
                    </div>
                    <p class="tour-listing-details__explore-text wow animated fadeInUp " data-wow-delay="0.1s" data-wow-duration="1500ms">
                        @Html.Raw(Model.PackageSummary)
                    </p>
                </div>
                
                @*Inclusions fetched on ajax*@
                <div id="inclusionListDiv">
                </div>


                @*Itinerary fetched on ajax*@
                <div id="itineraryListDiv">
                </div>


                @* <div class="tour-listing-details__amenities">
                <h3 class="tour-listing-details__title tour-listing-details__amenities-title">Tour Amenities</h3>
                <div class="tour-listing-details__amenities-row row">
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--one">
                <span class="icon-credit-card"></span>
                <h4 class="tour-listing-details__amenities-content-title">Accepts Credit Cards</h4>
                </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.3s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--two">
                <span class="icon-parking"></span>
                <h4 class="tour-listing-details__amenities-content-title">Car Parking</h4>
                </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.5s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--three">
                <span class="icon-discount"></span>
                <h4 class="tour-listing-details__amenities-content-title">Free Coupons</h4>
                </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--four">
                <span class="icon-reception-bell"></span>
                <h4 class="tour-listing-details__amenities-content-title">Reservation</h4>
                </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.3s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--five">
                <span class="icon-seat"></span>
                <h4 class="tour-listing-details__amenities-content-title">Outdoor Seating</h4>
                </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.5s" data-wow-duration="1500ms">
                <div class="tour-listing-details__amenities-content tour-listing-details__amenities-content--six">
                <span class="icon-restaurant"></span>
                <h4 class="tour-listing-details__amenities-content-title">Restaurant</h4>
                </div>
                </div>
                </div>
                </div> *@

                @if (!string.IsNullOrWhiteSpace(Model.TermsAndCondition))
                {
                    <div class="tour-listing-details__explore">
                        <div class="wow animated fadeIn" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            <h3 class="tour-listing-details__title tour-listing-details__explore-title">Terms And Condition</h3>
                        </div>
                        <p class="tour-listing-details__explore-text wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            @Html.Raw(Model.TermsAndCondition)
                        </p>
                    </div>
                }


                @*Price List fetched on ajax*@
                <div class="tour-listing-details__explore" id="priceListDiv">
                </div>

                @* Need to Add Similar Package Here *@

            </div>

            <div class="col-xl-4">
                <aside class="tour-listing-details__sidebar">
                    <div class="tour-listing-details__sidebar-book-tours tour-listing-details__sidebar-single wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <h3 class="tour-listing-details__sidebar-title">Book Tours</h3>
                        <a href="@Url.Action("BookNow","Package",new{Area="Customer",@Id=Model.Id})" class="tour-listing-details__sidebar-btn vietjet-btn vietjet-btn--base">
                            <span>
                                Book Now
                            </span>
                        </a>

                        <div class="result"></div><!-- /.result -->
                    </div>
                    <div id="flightListDiv">
                    </div>
                    @if (Model.Flights != null && Model.Flights.Any())
                    {
                        <div class="tour-listing-details__sidebar-book-tours tour-listing-details__sidebar-single wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            <h3 class="tour-listing-details__sidebar-title">Included Flights </h3>
                            @foreach (var flight in Model.Flights)
                            {
                                DateTime date = flight.DepartureDate.Date;
                                DateTime time = flight.DepartureDate;

                                <p>@($"{flight.Origin} to {flight.Destination} details :")</p>
                                <table class="table table-bordered">
                                    <tr>
                                        <th>Flight No</th>
                                        <td>@flight.FlightNumber</td>
                                    </tr>
                                    <tr>
                                        <th>PNR No</th>
                                        <td>@flight.PNRNumber</td>
                                    </tr>

                                </table>

                                <div class="row flight-bg">
                                    <div class="col-4 col-md-4 d-flex align-items-center">
                                        <strong>@flight.Origin</strong>
                                    </div>

                                    <div class="col-4 col-md-4 between-stop">
                                        <small class="ft">@date.ToString("dd/MM/yyyy")</small>
                                        <div class="line line--alternate">
                                            <i class="fa-solid fa-plane"></i>
                                        </div>
                                        <small>@time.ToString("hh:mm tt")</small>
                                    </div>

                                    <div class="col-4 col-md-4 d-flex align-items-center">
                                        <strong>@flight.Destination</strong>
                                    </div>
                                </div>
                                @if (flight.IsReturn && flight.ReturnDate.HasValue)
                                {
                                    date = flight.ReturnDate.Value.Date;
                                    time = flight.ReturnDate.Value;
                                    <div class="row flight-bg">
                                        <div class="col-4 col-md-4 d-flex align-items-center">
                                            <strong>@flight.Destination</strong>
                                        </div>

                                        <div class="col-4 col-md-4 between-stop">
                                            <small class="ft">@date.ToString("dd/MM/yyyy")</small>
                                            <div class="line line--alternate">
                                                <i class="fa-solid fa-plane"></i>
                                            </div>
                                            <small>@time.ToString("hh:mm tt")</small>
                                        </div>

                                        <div class="col-4 col-md-4 d-flex align-items-center">
                                            <strong>@flight.Origin</strong>
                                        </div>
                                    </div>
                                }
                                <hr>
                                <hr>
                            }
                        </div>
                    }


                    @*Hotel fetched on ajax*@
                    <div id="hotelListDiv">
                    </div>

                </aside><!-- /.tour-listing-details__sidebar -->
            </div>
        </div><!-- /.row -->
    </div>
</section>
@section Scripts {
    <script src="~/pagescripts/customer/package/detail.js"></script>
    <script>
        var pd = new PackageDetail();
        pd.Id = '@Model.Id';
        pd.init();
    </script>
}