@using vHolidays.Models.ViewModels.Home
@using vHolidays.Utility.Extensions

@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="main-slider-one">
    <div class="main-slider-one__carousel vietjet-owl__carousel owl-carousel owl-theme" data-owl-options='{
         "items" : 1,
         "margin" : 0,
         "loop" : true,
         "smartSpeed" : 700,
         "animateOut" : "fadeOut" ,
         "autoplayTimeout" : 10000,
         "nav" : true,
         "navText" : ["<span class=\"icon-left-arrow\"></span>","<span class=\"icon-right-arrow\"></span>"],
        "dots": false,
        "autoplay": true
        }'>
                <div class="item">
                    <div class="main-slider-one__image imglazyload"
                    data-src="assets/images/backgrounds/slider-1-1.jpg" style="background-image: url(assets/images/backgrounds/slider-1-1.jpg);"></div>
                    <div class="container">
                        <div class="main-slider-one__content">
                            <h5 class="main-slider-one__sub-title">Uncover Vietnam’s Beauty with VietjetHolidays </h5>
                            <h3 class="main-slider-one__title">Your gateway to adventure, culture, and unforgettable memories</h3>
                        </div>
                         <a href="https://www.youtube.com/watch?v=04Kf_0kppPM" class="video-btn video-popup" style="margin:50px auto 0 auto">
                                <i class="fa-solid fa-play"></i>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </a>
                    </div>
                </div>
                <div class="item">
                    <div class="main-slider-one__image imglazyload"
                    data-src="assets/images/backgrounds/slider-1-2.jpg" style="background-image: url(assets/images/backgrounds/slider-1-2.jpg);"></div>
                    <div class="container">
                        <div class="main-slider-one__content">
                            <h5 class="main-slider-one__sub-title">Explore Singapore with Vietjet Holidays! </h5>
                            <h3 class="main-slider-one__title">Unforgettable Tour Packages Tailored Just for You – Discover the Magic of Singapore! </h3>
                        </div>
                    </div>
                </div>
                <div class="item">
                    <div class="main-slider-one__image imglazyload"
                    data-src="assets/images/backgrounds/slider-1-3.jpg" style="background-image: url(assets/images/backgrounds/slider-1-3.jpg);"></div>
                    <div class="container">
                        <div class="main-slider-one__content">
                            <h5 class="main-slider-one__sub-title">Discover Your Dream Getaway with Vietjet</h5>
                            <h3 class="main-slider-one__title">Exclusive Tour Packages for a Journey Through the Land of Happiness! </h3>
                        </div>
                    </div>
                </div>
            </div>
</section>

<section class="about-one pt-120">
    <div class="container">
        <div class="row">
            <div class="col-xl-6 col-lg-6 wow fadeInLeft" data-wow-delay="200ms">
                <div class="about-one__image">
                    <div class="row">
                        <div class="col-md-5">
                            <div class="about-one__image__one vietjet-tilt" data-tilt-options='{ "glare": false, "maxGlare": 0, "maxTilt": 3, "speed": 700, "scale": 1 }'>
                                <img class="imglazyload" src="assets/images/resources/about-1-1.jpg" alt="Vietjet Holidays">
                                <img class="imglazyload" src="assets/images/resources/about-1-2.jpg" alt="Vietjet Holidays">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 178 30">
                                    <path d="M177.276 2.12957C155.784 21.96 90.3733 49.5857 0.667034 1.44487" />
                                </svg>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="about-one__image__two">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 163 75">
                                    <path d="M1.02818 74.4809C12.3872 47.5342 60.5019 -4.68383 162.089 2.01835" />
                                </svg>
                                <div class="vietjet-tilt" data-tilt-options='{ "glare": false, "maxGlare": 0, "maxTilt": 5, "speed": 700, "scale": 1 }'>
                                    <img src="assets/images/resources/about-1-3.jpg" alt="Vietjet Holidays">
                                </div>
                                <div class="about-one__image__two__shape">
                                    <img class="imglazyload" src="assets/images/shapes/about-1-shape-3.png" alt="Vietjet Holidays">
                                </div>
                                <div class="about-one__counter" style="background-image: url(assets/images/shapes/about-1-shape-4.png);">
                                    <div class="about-one__counter__number count-box"><span class="count-text" data-stop="30" data-speed="1500"></span>%</div>

                                    <p class="about-one__counter__title">Discount</p>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="about-one__shape-one">
                    <img class="imglazyload" src="assets/images/shapes/about-1-shape-1.png" alt="Vietjet Holidays">
                </div>
                <div class="about-one__shape-two">
                    <img class="imglazyload" src="assets/images/shapes/about-1-shape-2.png" alt="Vietjet Holidays">
                </div>

            </div>
            <div class="col-xl-6 col-lg-6 wow fadeInRight" data-wow-delay="200ms">
                <div class="about-one__content">
                    <div class="sec-title text-left">

                        <p class="sec-title__tagline">GET TO KNOW US</p>


                        <h2 class="sec-title__title">Experience the World with Vietjet Holidays.com</h2>

                    </div>
                    <p class="about-one__content__text">
                        Vietjet Holidays, managed by Vietjet Air's sales agents, offers a streamlined travel experience by bundling flights,
                        accommodations, and occasionally additional tours or activities into comprehensive holiday packages. This service
                        leverages Vietjet Air’s extensive network and operational expertise, ensuring competitive rates and a smooth booking process.
                    </p>
                    <div class="about-one__box">
                        <div class="about-one__box__icon"><span class="icon-safety"></span></div>
                        <h3 class="about-one__box__title">Safety Always</h3>
                        <p class="about-one__box__text">Your well-being is our top priority, ensuring every step of your journey is safe and secure.</p>
                    </div>
                    <div class="about-one__box">
                        <div class="about-one__box__icon"><span class="icon-friendly-Guide"></span></div>
                        <h3 class="about-one__box__title">Friendly<br> Guide</h3>
                        <p class="about-one__box__text">Our guides ensure a seamless, enjoyable experience with personalized support throughout your travels.</p>
                    </div>
                    <a href="javascript:void(0)" class="vietjet-btn"><span>Discover More</span></a>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.PackageList != null && Model.PackageList.Any())
{
    @await Html.PartialAsync("_partialPackageList", Model.PackageList)
}
<section class="why-choose-one">
    <div class="why-choose-one__bg imglazyload"
         data-src="assets/images/backgrounds/why-choose-bg-1.jpg" style="background-image: url(assets/images/backgrounds/why-choose-bg-1.jpg);"></div>
    <div class="container">
        <div class="row">
            <div class="col-xl-5 col-lg-6 wow fadeInUp" data-wow-delay="200ms">
                <div class="sec-title text-left">
                    <p class="sec-title__tagline text-gray">Are you ready to travel</p>
                    <h2 class="sec-title__title">Choose Our Tour Types<br> & Enjoy Now</h2>
                </div>
            </div>
            <div class="col-xl-7 col-lg-6 wow fadeInUp" data-wow-delay="200ms">
                <p class="why-choose-one__text">
                    Explore a variety of thrilling tours, each designed to give you a unique and unforgettable experience. Whether you're looking to immerse yourself in wildlife, feel the rush of paragliding, embark on an adventurous journey, or soar through the skies with hang gliding, our tours cater to every kind of traveler. Choose your adventure and start your journey today!
                </p>
            </div>
        </div>
        <div class="row gutter-y-30">
            <div class="col wow fadeInUp" data-wow-delay="100ms">
                <div class="why-choose-one__box">
                    <div class="why-choose-one__box__icon"><span class="icon-wildlife"></span></div>
                    <h3 class="why-choose-one__box__title">Adventure tours</h3>
                </div>
            </div>
            <div class="col wow fadeInUp" data-wow-delay="200ms">
                <div class="why-choose-one__box">
                    <div class="why-choose-one__box__icon"><span class="icon-paragliding-1"></span></div>
                    <h3 class="why-choose-one__box__title">Sightseeing tours</h3>
                </div>
            </div>
            <div class="col wow fadeInUp" data-wow-delay="300ms">
                <div class="why-choose-one__box">
                    <div class="why-choose-one__box__icon"><span class="icon-tent-1"></span></div>
                    <h3 class="why-choose-one__box__title">Cultural tours</h3>
                </div>
            </div>
            <div class="col wow fadeInUp" data-wow-delay="400ms">
                <div class="why-choose-one__box">
                    <div class="why-choose-one__box__icon"><span class="icon-world-1"></span></div>
                    <h3 class="why-choose-one__box__title">Historical tours</h3>
                </div>
            </div>
            <div class="col wow fadeInUp" data-wow-delay="400ms">
                <div class="why-choose-one__box">
                    <div class="why-choose-one__box__icon"><span class="icon-fishing-net-1"></span></div>
                    <h3 class="why-choose-one__box__title">Food tours</h3>
                </div>
            </div>
        </div>
    </div>
</section>

@{
    var pack = Model.PackageList.FirstOrDefault();
    var detailUrl = Url.Action("Detail", "Package", new { Area = "Customer", Id = pack?.Id ?? 0 });
    var mainImg = pack?.Images?.FirstOrDefault();
    var secondImg = pack?.Images?.Count() > 1 ? pack.Images.Last() : string.Empty;
}
@if (pack is not null)
{
    <section class="offer-one" style="background-image: url('assets/images/backgrounds/offer-1-bg.png');">
        <div class="container">
            <div class="row">
                <div class="col-xl-5 col-lg-6">
                    <div class="offer-one__content sec-title">
                        <p class="offer-one__top-title">Our Monthly Deal !</p>
                        <h2 class="offer-one__heading sec-title__heading">@pack.Name<br> with a Single Click</h2>
                        <p class="offer-one__text" style="color:#fff;">
                            @Html.Raw(pack.PackageSummary.TruncateWithLink(200, detailUrl))
                        </p>
                        <div class="offer-one__btn-box wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            <a href="@detailUrl" class="offer-one__btn vietjet-btn vietjet-btn--primary"><span>Start Booking</span></a>
                        </div>
                    </div>
                </div>
                <!-- /.col-xl-5 col-lg-6 -->
                <div class="col-xl-7 col-lg-6 wow animated fadeInRight" data-wow-delay="0.1s" data-wow-duration="1500ms">
                    <div class="offer-one__img-box">
                        <div class="offer-one__inner-img-box">
                            <img src="@mainImg" alt="offer" class="offer-one__img-one" style="border:8px solid #fff">
                            <img src="@secondImg" alt="offer" class="offer-one__img-two">
                            <img src="~/assets/images/offer/offer-1-3.png" alt="offer" class="offer-one__img-three" style="width: 400px;">
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.row -->
        </div>
        <div class="offer-one__shape-one vietjet-splax" data-para-options='{ "orientation": "left", "scale": 1.5, "overflow": true }' style="background-image: url('assets/images/shapes/offer-shape-1.png');"></div>

        <div class="offer-one__shape-two vietjet-splax" data-para-options='{ "orientation": "right", "scale": 1.5, "overflow": true }' style="background-image: url('assets/images/shapes/offer-shape-2.png');"></div>

        <div class="offer-one__bottom-bg" style="background-image: url('assets/images/offer/offer-1-4.png');"></div>

    </section>
}


<section class="counter-one">
    <div class="counter-one__bg-box"></div>
    <div class="counter-one__main-content">
        <div class="container">
            <div class="counter-one__container container-fluid">
                <div class="row">
                    <div class="col wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <div class="counter-box">
                            <div class="counter-box__inner sec-title count-box">
                                <h3 class="counter-box__count-text counter-box__count-text--one sec-title__heading count-text" data-stop="120" data-speed="1500">00</h3>
                                <h3 class="counter-box__count-text sec-title__heading">+</h3>
                            </div>
                            <!-- /.counter-box__inner -->
                            <p class="counter-box__title">Domestic & International Routes</p>
                        </div>
                    </div>
                    <!-- /.col-xl-3 col-lg-3 col-6 -->
                    <div class="col wow animated fadeInUp" data-wow-delay="0.3s" data-wow-duration="1500ms">
                        <div class="counter-box">

                            <div class="counter-box__inner sec-title count-box">
                                <h3 class="counter-box__count-text counter-box__count-text--one sec-title__heading count-text" data-stop="400" data-speed="1500">00</h3>
                                <h3 class="counter-box__count-text sec-title__heading">+</h3>
                            </div>
                            <!-- /.counter-box__inner -->
                            <p class="counter-box__title">Daily Flights</p>
                        </div>
                    </div>
                    <!-- /.col-xl-3 col-lg-3 col-6 -->
                    <div class="col wow animated fadeInUp" data-wow-delay="0.5s" data-wow-duration="1500ms">
                        <div class="counter-box">

                            <div class="counter-box__inner sec-title count-box">
                                <h3 class="counter-box__count-text counter-box__count-text--one sec-title__heading count-text" data-stop="6000" data-speed="1500">00</h3>
                                <h3 class="counter-box__count-text sec-title__heading">+</h3>
                            </div>
                            <!-- /.counter-box__inner -->
                            <p class="counter-box__title">Friendly & Dedicated Staffs</p>
                        </div>
                    </div>
                    <!-- /.col-xl-3 col-lg-3 col-6 -->
                    <div class="col wow animated fadeInUp" data-wow-delay="0.7s" data-wow-duration="1500ms">
                        <div class="counter-box counter-box--no-border">

                            <div class="counter-box__inner sec-title count-box">
                                <h3 class="counter-box__count-text counter-box__count-text--one sec-title__heading count-text" data-stop="100" data-speed="1500">00</h3>
                                <h3 class="counter-box__count-text sec-title__heading">+</h3>
                            </div>
                            <!-- /.counter-box__inner -->
                            <p class="counter-box__title">New & Eco-friendly Aircraft</p>
                        </div>
                    </div>

                    <div class="col wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <div class="counter-box">

                            <div class="counter-box__inner sec-title count-box">
                                <h3 class="counter-box__count-text counter-box__count-text--one sec-title__heading count-text" data-stop="7" data-speed="1500">00</h3>
                                <h3 class="counter-box__count-text sec-title__heading"><i class="fa-regular fa-star"></i></h3>
                            </div>
                            <!-- /.counter-box__inner -->
                            <p class="counter-box__title">The Highest Ranking for Aviation Safety with 7 Stars</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

