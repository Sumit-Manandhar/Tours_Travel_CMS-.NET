@using vHolidays.Models.Hotel
@model List<Hotel>

@{
    Layout = null;
}
<div class="tour-listing-details__sidebar-post-box tour-listing-details__sidebar-single wow animated fadeInUp animated" data-wow-delay="0.1s" data-wow-duration="1500ms" style="visibility: visible; animation-duration: 1500ms; animation-delay: 0.1s; animation-name: fadeInUp;">
    <h3 class="tour-listing-details__sidebar-title tour-listing-details__sidebar-post-title">Hotels</h3>
    <ul class="tour-listing-sidebar-post">
        <li class="tour-listing-sidebar-post__item">
            <div class="tour-listing-sidebar-post__image">
                <img src="~/assets/images/tours/tour-listing-details-post-1.jpg" alt="last-post">
            </div>
            <div class="tour-listing-sidebar-post__content">
                <p class="tour-listing-sidebar-post__price">$380</p>
                <h5 class="tour-listing-sidebar-post__link">First Eden hotel</h5>
                <div class="tour-listing-sidebar-post__location">
                    <span class="icon-location-1"></span>
                    <p class="tour-listing-sidebar-post__location-text text-small">Ha Noi, Vietnam</p>
                </div>
            </div>
        </li>
        <li class="tour-listing-sidebar-post__item">
            <div class="tour-listing-sidebar-post__image">
                <img src="~/assets/images/tours/tour-listing-details-post-2.jpg" alt="last-post">
            </div>
            <div class="tour-listing-sidebar-post__content">
                <p class="tour-listing-sidebar-post__price">$380</p>
                <h5 class="tour-listing-sidebar-post__link">Sapa Charm</h5>
                <div class="tour-listing-sidebar-post__location">
                    <span class="icon-location-1"></span>
                    <p class="tour-listing-sidebar-post__location-text text-small">Sapa, Vietnam</p>
                </div>
            </div>
        </li>
        <li class="tour-listing-sidebar-post__item">
            <div class="tour-listing-sidebar-post__image">
                <img src="~/assets/images/tours/tour-listing-details-post-3.jpg" alt="last-post">
            </div>
            <div class="tour-listing-sidebar-post__content">
                <p class="tour-listing-sidebar-post__price">$380</p>
                <h5 class="tour-listing-sidebar-post__link">Mandila</h5>
                <div class="tour-listing-sidebar-post__location">
                    <span class="icon-location-1"></span>
                    <p class="tour-listing-sidebar-post__location-text text-small">Da Nang, Vietnam</p>
                </div>
            </div>
        </li>
    </ul>
</div>