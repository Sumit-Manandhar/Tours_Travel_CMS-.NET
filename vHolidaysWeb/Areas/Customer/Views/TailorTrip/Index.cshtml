@using vHolidays.Models.TailorTrip.DataTransferObjects
@model TailorTripCreateModel
@{
    ViewData["Title"] = "Tailor Made Trip";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.1.0/build/css/intlTelInput.css">

<section class="page-header pt-40 pb-40">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2 class="page-header__title wow animated fadeInLeft animated animated" data-wow-delay="0s" data-wow-duration="1500ms" style="visibility: visible; animation-duration: 1500ms; animation-delay: 0s; animation-name: fadeInLeft;">
                    Tailor Made Trip
                </h2>
                <p class="text-white">Customize your trip the way you like it</p>
            </div>
        </div>
    </div>
</section>

<section class="pt-40 pb-40">
    <div class="container">
        <div class="row">
            @await Html.PartialAsync("_partialCreateTrailorMadeTrip", Model)
        </div>
    </div>
</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.1.0/build/js/intlTelInput.min.js"></script>

    <script src="~/pagescripts/customer/tailortrip/index.js"></script>
    <script>
        var tt = new TailorTrip();
        tt.init();
    </script>
}