@using Travels.Models.Package.DataTransferObjects
@using Travels.Utility.Enumerations
@model PackageDetailAddUpdateModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["PackageDetailId"] = Model.Id;
    ViewData["Title"] = "Edit";
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var controller = IsGroupBooking ? "GroupBooking" : "Package";
    var displayText = IsGroupBooking ? "Group Booking" : "Package";
}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@displayText</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", controller, new { Area = "Admin" })">@displayText</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                @await Html.PartialAsync("~/Areas/Admin/Views/Package/_partialTabList.cshtml", (int)PackageTabMenu.Detail)

                <div class="row">
                    <div class="tab-content pt-2" id="packageTabContents">
                        <div class="tab-pane fade active show" id="Detail" role="tabpanel" aria-labelledby="Detail-tab">

                            <form asp-action="Create" asp-controller="@controller" method="post" id="updateForm">
                                @Html.HiddenFor(model => model.Id)
                                <div class="row g-3 mt-2">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label for="inputText" class="col-sm-12 col-form-label">Tour Type</label>
                                            @Html.ListBoxFor(model => model.TourTypeId, new SelectList(Model.TourTypes, "Id", "Name"), new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.TourTypeId, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-6">
                                           
                                            <label for="inputText" class="col-sm-12 col-form-label">@(IsGroupBooking ? "Hotel Category" : "Class type") </label>
                                            @Html.ListBoxFor(model => model.ClassOptionId, new SelectList(Model.ClassOptionTypes, "Id", "Name"), new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.ClassOptionId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label for="inputText" class=col-sm-4 col-form-label">Code</label>
                                            <input type="text" asp-for="Code" class="form-control" placeholder="Code">
                                            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-6">
                                            <label for="inputText" class=col-sm-4 col-form-label">Name</label>
                                            <input type="text" asp-for="Name" class="form-control" placeholder="Name">
                                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label for="inputText" class="col-sm-4 col-form-label">Country</label>
                                            @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countries, "Id", "CountryName"),
                                                     new { @class = "form-control select2" })
                                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-4">
                                            <label for="inputText" class="col-sm-4 col-form-label">@(IsGroupBooking ? "Closed date" : "Validity")</label>
                                            <input type="date" asp-for="Validity" class="form-control" placeholder="Validity">
                                            @Html.ValidationMessageFor(model => model.Validity, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-4">
                                            <label for="inputText" class="col-sm-4 col-form-label">Rating</label>
                                            <input type="number" asp-for="Rating" class="form-control" placeholder="Rating" step="any">
                                            @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4">
                                            <label for="inputText" class="col-sm-4 col-form-label">Day</label>
                                            <input type="number" asp-for="Day" class="form-control" placeholder="Code">
                                            @Html.ValidationMessageFor(model => model.Day, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-4">
                                            <label for="inputText" class="col-sm-4 col-form-label">Night</label>
                                            <input type="number" asp-for="Night" class="form-control" placeholder="Name">
                                            @Html.ValidationMessageFor(model => model.Night, "", new { @class = "text-danger" })
                                        </div>
                                        @if (IsGroupBooking)
                                        {
                                            <div class="col-md-4">
                                                <label for="inputText" class="col-sm-4 col-form-label">@(IsGroupBooking ? "Departure date" : "Start Date")</label>
                                                <input type="date" asp-for="StartDate" class="form-control" placeholder="StartDate">
                                                @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                            </div>
                                        }
                                        else
                                        {
                                            @Html.HiddenFor(model => model.StartDate)
                                        }
                                        @* <div class="col-md-4">
                                        <label for="inputText" class=col-sm-4 col-form-label">MinAge</label>
                                        <input type="number" asp-for="MinAge" class="form-control" placeholder="Min Age">
                                        @Html.ValidationMessageFor(model => model.MinAge, "", new { @class = "text-danger" })
                                        </div> *@
                                    </div>

                                    <div class="row mt-2">
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                                <label class="form-check-label" asp-for="IsPublished">
                                                    Published
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                                <label class="form-check-label" asp-for="IsActive">
                                                    Active
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" asp-for="IsDeleted">
                                                <label class="form-check-label" asp-for="IsDeleted">
                                                    Delete
                                                </label>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            @if (!string.IsNullOrEmpty(Model?.PackageImgUrl))
                                            {
                                                <div class="col-md-3">
                                                    <div class="image-container">
                                                        <img src="@(Model.BaseUrl+Model?.PackageImgUrl??"")" id="img-banner" alt="Banner Img" style="max-width: 200px;">
                                                    </div>
                                                </div>
                                            }


                                            <label for="inputText" class="col-sm-6 col-form-label">Banner Image</label>
                                            <input type="file" asp-for="PackageImg" class="form-control" />
                                            <input type="hidden" asp-for="PackageImgUrl" class="form-control" />
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <label for="inputText" class=col-sm-4 col-form-label">Package Summary</label>
                                        <textarea class="form-control" asp-for="PackageSummary"> </textarea>
                                        @Html.ValidationMessageFor(model => model.PackageSummary, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-12">
                                        <label for="inputText" class=col-sm-4 col-form-label">Terms And Condition</label>
                                        <textarea class="form-control" asp-for="TermsAndCondition"> </textarea>
                                        @Html.ValidationMessageFor(model => model.TermsAndCondition, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                                @Html.HiddenFor(model => model.PackageType)

                                <div class="pt-3">
                                    <button type="button" class="btn btn-primary" id="submitEditForm">Submit</button>
                                    <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Index", controller, new { Area = "Admin" })'">Back</button>
                                </div>
                            </form>

                        </div>
                    </div>


                </div>
            </div>

        </div>
    </div>
    @section Scripts {
        <script src="~/pagescripts/admin/package/editpackage.js"></script>
        <script>
            var cp = new EditPackage();
            cp.init();
        </script>
    }
