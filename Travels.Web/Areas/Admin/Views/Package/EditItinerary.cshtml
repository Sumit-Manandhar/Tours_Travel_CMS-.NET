@using Travels.Models.Package.DataTransferObjects
@model List<ItineraryAddUpdateModel>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    ViewData["Title"] = "AddUpdateItinerary";
    var PackageDetailId = (int)ViewData["PackageDetailId"];
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var controller = IsGroupBooking ? "GroupBooking" : "Package";
    var displayText = IsGroupBooking ? "Group Booking" : "Package";
}
<style>
    label.error {
        color: red;
    }
</style>
<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@displayText- Add/Edit Itinerary</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index",controller,new {Area="Admin"})">@displayText</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Itinerary",controller,new {Area="Admin",id=PackageDetailId})">Itinerary</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" asp-controller="Package" method="post" id="saveItineraryForm">
                    <input type="hidden" name="PackageDetailId" value="@PackageDetailId" />

                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-top:20px">
                                    <table class="table customize-table table-bordered mb-0 v-middle" id="tblItti">
                                        <thead class="table-light">
                                            <tr>
                                                <td>Day</td>
                                                <td>Name</td>
                                                <td>Description</td>
                                                @*  <td>State</td> *@
                                                <td>Action</td>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            @if (Model.Count > 0)
                                            {
                                                var ct = 0;
                                                @foreach (var i in Model)
                                                {
                                                    <tr>


                                                        <td>
                                                            <input type="text" name="Itineraries[@ct].Day" id="Itineraries[@ct].Day" class="form-control " placeholder="Day"  value="@i.Day" required />
                                                            <input type="hidden" name="Itineraries[@ct].Id" id="Itineraries[@ct].Id" value="@i.Id" class="form-control" placeholder="Day" required />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="Itineraries[@ct].Name" id="Itineraries[@ct].Day" class="form-control" placeholder="Name" value="@i.Name" required />
                                                        </td>
                                                        <td>
                                                            <textarea type="text" name="Itineraries[@ct].Description" id="" class="form-control upTextedt" placeholder="Day" required>@i.Description</textarea>
                                                        </td>
                                                        <td>

                                                            <button type="button" class="btn btn-danger btn-sm" data-action="delete-row">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    ct++;
                                                }
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td>
                                                    <input type="text" name="AC.Day" id="AC.Day" class="form-control" placeholder="Day" required />
                                                </td>
                                                <td>
                                                    <input type="text" name="AC.Name" id="AC.Day" class="form-control" placeholder="Name" required />
                                                </td>
                                                <td>
                                                    <textarea type="text" name="AC.Description" id="ACDescription" class="form-control txtEditor" placeholder="Description" required></textarea>
                                                </td>
                                              
                                                <td>
                                                    <button type="button" class="btn btn-danger btn-sm" data-action="add-row">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-sm" data-action="delete-row" style="display:none;">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </td>

                                            </tr>



                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3">
                        <button type="button" id="addUpdateItinerary" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Itinerary",controller,new {Area="Admin",id=PackageDetailId})'">Back</button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script src="~/js/tableform.js"></script>
    <script src="~/pagescripts/admin/package/additinerary.js"></script>
    <script>
        var pi = new PackageItinerary();
        pi.init();
    </script>
}