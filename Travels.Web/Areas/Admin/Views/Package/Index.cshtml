@using Travels.Models.Package.DatabaseModel
@using Travels.Models.Package.DataTransferObjects
@model List<PackageDetail>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var displayText = IsGroupBooking ? "Group Booking" : "Package";
    ViewData["Title"] = displayText;

}


<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@displayText</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item active">@displayText</li>
        </ol>
    </div>
</div>

<br />
<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">
                <div class="row" style="margin-top:20px">
                    <div class="form-group col-md-3 mb-2">
                        <div class="input-group">
                            <input type="text" class="form-control input-sm" id="Keyword" placeholder="Search by Name" autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group col-md-3 mb-2">
                        <button type="button" id="btn-search" class="btn btn-primary">
                            <i class="fa-solid fa-magnifying-glass"></i>Search
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div id="dataListContainer">

            @using (Html.BeginForm("Index", "Package", FormMethod.Post, new { id = "SearchForm" }))
            {
                <div class="row" style="padding:inherit">
                    <div class="col-lg-12">
                        <div class="card mb-2">
                            <div class="card-body">
                                <div class="row" style="margin-top:20px">
                                    <div class="form-group col-md-3 mb-2">
                                        <button type="button" id="btn-add" class="btn btn-primary">
                                            <i class="fa-solid fa-plus"></i>  Add
                                        </button>
                                    </div>
                                </div>
                                <div id="dataList">
                                    @await Html.PartialAsync("~/Areas/Admin/Views/Package/_partialPackageList.cshtml", Model)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>

</div>

<!-- End Basic Modal-->
@section Scripts {
    <script src="~/pagescripts/admin/package/index.js"></script>
    <script>
        var d = new PackageDetail();
        var isGroupBooking = @Json.Serialize(IsGroupBooking);
        d.init();
    </script>
}
