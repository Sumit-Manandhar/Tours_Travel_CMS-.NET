@using Travels.Models.Package.DatabaseModel
@using Travels.Utility.Enumerations
@model List<PackageImage>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var PackageDetailId = (int)ViewData["PackageDetailId"];
    ViewData["Title"] = "Package Images";
    bool IsGroupBooking = (bool)ViewData["IsGroupBooking"];
    var controller = IsGroupBooking ? "GroupBooking" : "Package";
    var displayText = IsGroupBooking ? "Group Booking" : "Package";
}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@displayText</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index",controller,new {Area="Admin"})">@displayText</a></li>
            <li class="breadcrumb-item active">Edit</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                @await Html.PartialAsync("~/Areas/Admin/Views/Package/_partialTabList.cshtml", (int)PackageTabMenu.Images)

                <div class="row">
                    <div class="tab-content pt-2" id="packageTabContents">
                        <div class="tab-pane fade active show" id="Detail" role="tabpanel" aria-labelledby="Detail-tab">

                            <form asp-action="Create" asp-controller="@controller" method="post" id="updateForm">
                                <input type="hidden" id="PackageDetailId" value="@PackageDetailId" />
                                @if (Model != null && Model.Any())
                                {
                                    <div class="row">

                                        @foreach (var image in Model)
                                        {
                                            <div class="col-md-3" id="@image.Id">
                                                <div class="form-group" style="position: relative; display: inline-block;">
                                                    <img src="@("/"+image.ImageUrl)" class="img-thumbnail" style="max-width: 200px;" />
                                                    <button type="button" data-id="@image.Id" class="delete-img" style="position: absolute; top: 10px; left: 10px; background-color: red; color: white; border: none; padding: 5px 10px; cursor: pointer;">
                                                        <i class="fa fa-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="col-md-12">
                                    <label for="inputText" class="col-sm-6 col-form-label">Additional Images</label>
                                    <div id="imageUploadContainer" class="dropzone">
                                    </div>
                                </div>

                                <div class="pt-3">
                                    <button type="button" class="btn btn-primary" id="submitEditForm">Submit</button>
                                    <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Index", controller, new { Area = "Admin" })'">Back</button>
                                </div>
                            </form>

                        </div>
                    </div>


                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {

    <script src="~/pagescripts/admin/package/packageimage.js"></script>
    <script>
        var pi = new PackageImage();
        pi.init();
    </script>
}
