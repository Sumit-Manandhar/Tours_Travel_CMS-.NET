@using Travels.Models.Package.DataTransferObjects
@model GroupAddUpdateModel

<div class="modal fade" id="addUpdateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add/Update Group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form asp-action="AddUpdateGroup" asp-controller="Package" method="post" class="row" id="saveGroupForm">
                    @Html.HiddenFor(model => model.Id)
                    @Html.HiddenFor(model => model.PackageDetailId)
                    @Html.HiddenFor(model => model.Order)
                    <div class="row">
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-12 col-form-label">Adult</label>
                            <input type="number" asp-for="Adult" class="form-control" placeholder="Adult">
                            @Html.ValidationMessageFor(model => model.Adult, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-12 col-form-label">Free Of Cost</label>
                            <input type="number" asp-for="FreeOfCost" class="form-control" placeholder="1">
                            @Html.ValidationMessageFor(model => model.FreeOfCost, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="SingleSupliment">
                                <label class="form-check-label" asp-for="SingleSupliment">
                                    Single Supliment
                                </label>
                            </div>
                        </div>    
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>              
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (Model.Id > 0)
                    {
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsDeleted">
                                    <label class="form-check-label" asp-for="IsDeleted">
                                        Delete
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </form>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="addUpdateGroup">Save changes</button>
            </div>
        </div>
    </div>
</div>
