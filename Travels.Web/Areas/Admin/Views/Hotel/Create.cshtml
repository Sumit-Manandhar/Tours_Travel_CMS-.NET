@using Travels.Models.Hotel;
@model HotelListViewModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if (Model.Id == 0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        ViewData["Title"] = "Add";

    }
    else ViewData["Title"] = "Edit";


}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@(Model.Id == 0 ? "Add Hotel" : $"Edit Hotel - {Model.HotelName}")</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/Hotel">Hotel</a> </li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="Create" asp-controller="hotel" method="post" id="UpdateHotelForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <input type="hidden" asp-for="IsDeleted" class="form-control" />
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-6 col-form-label">Hotel Name</label>
                            <input type="text" asp-for="HotelName" class="form-control" placeholder="Hotel Name">
                            @Html.ValidationMessageFor(model => model.HotelName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Country</label>
                            @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countries, "Id", "CountryName"),
                                     new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">City</label>
                            <select asp-for="CityId">
                                @if (Model.Cities is not null)
                                {
                                    foreach (var city in Model.Cities)
                                    {
                                        if (Model.CityId == city.Id)
                                        {
                                            <option value="@city.Id" selected> @city.CityName  </option>
                                        }
                                        else
                                        {    <option value="@city.Id"> @city.CityName  </option>
                                        }

                                    }
                                }
                                else
                                {
                                    <option>Select Country First to select City</option>
                                }
                            </select>

                            @Html.ValidationMessageFor(model => model.CityId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Address Line</label>
                            <input type="text" asp-for="AddressLine" class="form-control" placeholder="Address Line">
                            @Html.ValidationMessageFor(model => model.AddressLine, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-6 col-form-label">Image</label>
                            <div class="image-container">
                                <img src="@(Model.BaseUrl+Model?.DisplayImageUrl??"")" id="img" alt="Img" style="aspect-ratio:1.5; max-width:250px">
                            </div>
                            <div class="row">
                                <input type="file" name="Image" id="Image" class="form-control">

                            </div>
                            <input type="hidden" asp-for="DisplayImageUrl" />
                        </div>

                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>



                    </div>
                    @Html.HiddenFor(a=>a.RedirectUrl)
                    @Html.HiddenFor(a=>a.PackageId)
                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/hotel/createhotels.js"></script>
    <script>
        var cd = new createHotel();
        cd.init();
    </script>
}
