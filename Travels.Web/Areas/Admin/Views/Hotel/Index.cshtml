@using Travels.Models.Hotel
@model List<Hotel>

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Hotels";

}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Hotels</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item active"> Hotels</li>
        </ol>
    </div>
</div>

<br />

<br />


<div class="row">
    <div class="col-lg-12">
        <div class="card mb-2">
             <div class="card-body">
                <div class="row" style="margin-top:20px">
                    <div class="form-group col-md-3 mb-2">
                        <div class="input-group">
                            <input type="text" class="form-control input-sm" id="Keyword" placeholder="Search by Hotel Name" autocomplete="off">
                        </div>
                    </div>
                    <div class="form-group col-md-3 mb-2">
                        <button type="button" id="btn-search" class="btn btn-primary">
                        <i class="fa-solid fa-magnifying-glass"></i>Search
                        </button>
                    </div>
                </div>
            </div>
         </div>

            <div id="DestinationListContainer">

                @using (Html.BeginForm("Index", "Destination", FormMethod.Post, new { id = "SearchForm" }))
                {
                    <div class="row" style="padding:inherit">
                        <div class="col-lg-12">
                            <div class="card mb-2">
                                <div class="card-body">
                                    <div class="row" style="margin-top:20px">
                                        <div class="form-group col-md-3 mb-2">
                                            <button type="button" id="btn-add" class="btn btn-primary">
                                                <i class="fa-solid fa-plus"></i>  Add
                                            </button>
                                        </div>
                                    </div>
                                    <div>
                                        <div id="invoiceList">
                                            <div class="col-lg-12">

                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="table-responsive" style="margin-top:20px">
                                                            <table class="table customize-table table-bordered mb-0 v-middle">
                                                                <thead class="table-light">
                                                                    <tr>
                                                                        <td>
                                                                            Id
                                                                        </td>
                                                                        <th>
                                                                            Name
                                                                        </th>
                                                                        <td>
                                                                            Address Line
                                                                        </td>
                                                                        <th>
                                                                            City
                                                                        </th>
                                                                        <td>
                                                                            Country
                                                                        </td>
                                                                        <td>Active</td>
                                                                        <td>Published</td>
                                                                        <td>Deleted?</td>

                                                                        <td>Actions</td>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model is not null && Model.Count > 0)
                                                                    {
                                                                        foreach (var item in Model)
                                                                        {
                                                                            <tr>
                                                                                <td>@item.Id </td>
                                                                                <td>@item.HotelName  </td>
                                                                                <td>@item.AddressLine  </td>
                                                                                <td>@item.City.CityName </td>
                                                                                <td>@item.Country.CountryName </td>
                                                                                <td>@item.IsActive </td>
                                                                                <td>@item.IsPublished </td>
                                                                                <td>@item.IsDeleted </td>
                                                                                <td>
                                                                                    <a href="#" class="link" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                                                                        <i class="fa-solid fa-ellipsis"></i>
                                                                                    </a>
                                                                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                                                                        <li><a class="dropdown-item" href="@Url.Action("Create", "Hotel", new { Area = "Admin", id= item.Id})" data-id="@item.Id"><i class="fa-solid fa-pen"></i> Edit </a></li>
                                                                                        <li>
                                                                                            <a class="dropdown-item btn-delete" href="javascript:void(0)" data-id="@item.Id">
                                                                                                @if (item.IsDeleted)
                                                                                                {
                                                                                                    <i class="fa-solid fa-trash-arrow-up"></i>
                                                                                                    <span>Restore</span>
                                                                                                }
                                                                                                else
                                                                                                {
                                                                                                    <i class="fa-solid fa-trash"></i>
                                                                                                    <span>Delete</span>



                                                                                                }
                                                                                            </a>
                                                                                        </li>

                                                                                    </ul>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <tr>
                                                                            <td colspan="6">
                                                                                <div class="text-center">
                                                                                    <h5 class="card-title">No hotels Found</h5>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#btn-add').on('click', function () {
                window.location.href = "/Admin/Hotel/Create/?Id=0";
            })
                $('#btn-search').on('click', function () {
            window.location.href = "/Admin/Hotel/Index?keyword=" + $('#Keyword').val();
        })
            //$('.btn-edit').on('click', function () {
            //    var Id = $(this).data("id")
            //    addUpdate(Id)
            //});
            $('.btn-delete').on('click', function () {
                var Id = $(this).data("id")
                $.ajax({
                    type: 'POST',
                    url: '/Admin/Hotel/SwitchDelete',
                    dataType: 'JSON',
                    data: { id: Id },
                    success: function (response, strStatus) {
                        showSuccessMessage(response.message, function () {
                            location.reload();
                        });
                    },
                    error: function (xhr, status, error) {
                        showErrorMessage(error);
                    }
                });
            });
        });

    </script>
}


