@using Travels.Models.Settings;
@model List<ContactUsMessages>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Messages";

}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Contacts</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item active"> Messages</li>
        </ol>
    </div>
</div>

<br />

<br />


<div class="row">
    <div class="col-lg-12">
        <div class="card mb-2">
            @*  <div class="card-body">
            <div class="row" style="margin-top:20px">
            <div class="form-group col-md-3 mb-2">
            <div class="input-group">
            <input type="text" class="form-control input-sm" id="Keyword" placeholder="Search by Destination Name" autocomplete="off">
            </div>
            </div>
            <div class="form-group col-md-3 mb-2">
            <button type="button" id="btn-search" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i>Search
            </button>
            </div>
            </div>
            </div>
            </div> *@

            <div id="DestinationListContainer">

                @using (Html.BeginForm("Index", "Destination", FormMethod.Post, new { id = "SearchForm" }))
                {
                    <div class="row" style="padding:inherit">
                        <div class="col-lg-12">
                            <div class="card mb-2">
                                <div class="card-body">

                                    <div id="invoiceList">
                                        <div class="col-lg-12">

                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="table-responsive" style="margin-top:20px">
                                                        <table class="table customize-table table-bordered mb-0 v-middle">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>
                                                                        Name
                                                                    </th>
                                                                    <th>
                                                                        Email
                                                                    </th>
                                                                    <td>
                                                                        Phone Number
                                                                    </td>
                                                                    <td>
                                                                        Subject
                                                                    </td>
                                                                    <td>
                                                                        Message
                                                                    </td>
                                                                    @*  <td>Actions</td> *@
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model is not null && Model.Count > 0)
                                                                {
                                                                    foreach (var item in Model)
                                                                    {
                                                                        <tr>

                                                                            <td>@item.SenderName </td>
                                                                            <td>@item.SenderEmail </td>
                                                                            <td>@item.SenderPhoneNumber </td>
                                                                            <td>@item.Subject </td>
                                                                            <td>@item.Message </td>

                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td colspan="6">
                                                                            <div class="text-center">
                                                                                <h5 class="card-title">No Message Found</h5>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
            </div>
        </div>

    </div>
</div>




