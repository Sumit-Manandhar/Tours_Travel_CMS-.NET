@using Travels.Models.TailorTrip.DataTransferObjects
@model TailorTripDto
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Tailor trip detail</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/TailorTrip">Tailor Trip</a> </li>
            <li class="breadcrumb-item active"> Detail</li>
        </ol>
    </div>
</div>

<br />



<div class="row">
    <div class="col-lg-12">
        <div class="card mb-2">
            <div class="container mt-4">

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header">
                                <h5>Detail</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-5">TravelDate</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.TravelDate)</dd>
                                    <dt class="col-sm-5">Length</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Length)</dd>
                                    <dt class="col-sm-5">HotelCategory</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.HotelCategory)</dd>
                                    <dt class="col-sm-5">Activity</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Activity)</dd>
                                    <dt class="col-sm-5">Adult</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Adult)</dd>
                                    <dt class="col-sm-5">Child</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Child)</dd>
                                    <dt class="col-sm-5">Infant</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Infant)</dd>
                                    <dt class="col-sm-5">Country</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.Country)</dd> 
                                    <dt class="col-sm-5">City</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.City)</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <div class="card">
                            <div class="card-header">
                                <h5>Personal Detail</h5>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-5">Salutation</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.Salutation)</dd>
                                    <dt class="col-sm-5">FirstName</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.FirstName)</dd>
                                    <dt class="col-sm-5">LastName</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.LastName)</dd>
                                    <dt class="col-sm-5">Email</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.Email)</dd>
                                    <dt class="col-sm-5">PhoneNumber</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.PhoneNumber)</dd>
                                    <dt class="col-sm-5">Country</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.Country)</dd>
                                    <dt class="col-sm-5">SpecialRequest</dt>
                                    <dd class="col-sm-7">@Html.DisplayFor(model => model.PersonalDetail.SpecialRequest)</dd>
                                </dl>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
