@using Travels.Models.Regions.DataTransferObject
@model AddCityDtos

@{
    Layout = null;
}
<div class="modal fade" id="addUpdateModal" tabindex="-1">
    <form asp-action="AddUpdateInclusion" asp-controller="Package" method="post" class="row" id="addUpdateCityForm">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add/Update City</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <input type="hidden" asp-for="IsDeleted" class="form-control" />
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Country</label>
                            @Html.DropDownListFor(m => m.CountryId, Model.Countries, " Select Countries ", new { @class = "form-control" })

                            @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Name</label>
                            <input type="text" asp-for="CityName" class="form-control" placeholder="City Name">
                            @Html.ValidationMessageFor(model => model.CityName, "", new { @class = "text-danger" })
                        </div>
                      


                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>



                    </div>



                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="btn-addUpdatecity">Save changes</button>
                </div>
            </div>
        </div>
    </form>
</div>