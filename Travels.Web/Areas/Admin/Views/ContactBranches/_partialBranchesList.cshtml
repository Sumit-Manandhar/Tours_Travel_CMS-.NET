@using Travels.Models.Settings

@model List<ContactBranches>
@{
    Layout = null;
}
<div class="col-lg-12">

    <div class="row">
        <div class="col-md-12">
            <div class="table-responsive" style="margin-top:20px">
                <table class="table customize-table table-bordered mb-0 v-middle">
                    <thead class="table-light">
                        <tr>
                            <th>
                                id
                            </th>
                            <th>
                                Branch
                            </th>
                            <td>
                                Type
                            </td>
                            <td>
                                Country
                            </td>
                            <td>
                                Deleted?
                            </td>
                            <td>Actions</td>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model is not null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>@item.Id </td>
                                    <td>@item.BranchName </td>
                                    <td>@item.BranchType </td>
                                    <td>@item.BranchCountry </td>
                                    <td>@item.IsDeleted </td>
                                    <td>
                                        <a href="#" class="link" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa-solid fa-ellipsis"></i>
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                            @*                                                     <li><a class="dropdown-item" target="_blank" href="~/Admin/Destination/Details?id=@item.Id"><i class="fa-solid fa-circle-info"></i> Detail</a></li>
                                    *@
                                            <li><a class="dropdown-item" href="@Url.Action("Agents", "ContactBranches", new { Area = "Admin", id= item.Id})"><i class="fa-solid fa-person"></i> Agents</a></li>
                                            <li><a class="dropdown-item" href="@Url.Action("Create", "ContactBranches", new { Area = "Admin", id= item.Id})" data-id="@item.Id"><i class="fa-solid fa-pen"></i> Edit </a></li>
                                            <li>
                                                <a class="dropdown-item btn-delete" href="javascript:void(0)" data-id="@item.Id">
                                                    @if (item.IsDeleted)
                                                    {
                                                        <i class="fa-solid fa-trash-arrow-up"></i>
                                                        <span>Restore</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-trash"></i>
                                                        <span>Delete</span>



                                                    }
                                                </a>
                                            </li>

                                        </ul>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="text-center">
                                        <h5 class="card-title">No branch Found</h5>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
