@using Travels.Models.Settings.DataTransferObjects;
@model BranchesDTO
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if (Model.Id == 0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        ViewData["Title"] = "Add";
    }
    else
    {
        ViewData["Title"] = "Edit";

    }

}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">@ViewData["Title"] Branch</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/ContactBranches">Branches</a> </li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="SaveBranches" asp-controller="Contact" method="post" id="UpdateContactForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">name</label>
                            <input type="text" asp-for="BranchName" class="form-control" placeholder="Branch Name">
                            @Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Branch Type</label>
                            <input type="text" asp-for="BranchType" class="form-control" placeholder="Branch type">
                            @Html.ValidationMessageFor(model => model.BranchType, "", new { @class = "text-danger" })
                        </div>
                    @*     <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Country </label>
                            <input type="text" asp-for="BranchCountry" class="form-control" placeholder="Country">
                            @Html.ValidationMessageFor(model => model.BranchCountry, "", new { @class = "text-danger" })
                        </div> *@
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-2 col-form-label">Country</label>
                            @Html.DropDownListFor(model => model.BranchCountry, new SelectList(Model.Countries, "CountryName", "CountryName"),
                                     new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.BranchCountry, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Contact Email</label>
                            <input type="text" asp-for="Email" class="form-control" placeholder="Contact Email">
                            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-6 col-form-label">Address</label>
                            <input type="text" asp-for="Address" class="form-control" placeholder="Contact Address">
                            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Number</label>
                            <input type="text" asp-for="ContactNumber" class="form-control"
                            placeholder="number">
                            @Html.ValidationMessageFor(model => model.ContactNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Optional Number</label>
                            <input type="text" asp-for="OptionalNumber" class="form-control"
                                   placeholder="Optional Number">
                            @Html.ValidationMessageFor(model => model.OptionalNumber, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-12">
                            <label for="inputText" class="col-sm-6 col-form-label">Image</label>
                            <div class="image-container">
                                <img src="@(Model.BaseUrl+Model?.ImageURL??"")" id="img" alt="Img">
                            </div>
                            <input type="file" name="Image" id="Image" class="form-control"
                                   >
                            <input type="hidden" asp-for="ImageURL" />
                        </div>

                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>



                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" id="btn-agent" class="btn btn-primary">Submit & Add Agent</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/contacts/createbranches.js"></script>
    <script>
        var cd = new Createbranches();
        cd.init();
    </script>
}
