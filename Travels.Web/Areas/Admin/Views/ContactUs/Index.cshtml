@using Travels.Models.Settings
@model List<Contacts>
@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin">Dashboard</a></li>
            <li class="breadcrumb-item active"> @ViewData["Title"]</li>
        </ol>
    </nav>
</div><!-- End Page Title -->
<section class="section">
    <div class="row">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@ViewData["Title"]</h5> 
                <div class="col-md-12 text-center">
                    <button class="btn btn-primary" type="submit">Submit form</button>
                </div>
                @*      <div class="row" style="margin-top:20px">
                <div class="form-group col-md-3 mb-2">
                <div class="input-group">
                <input type="text" class="form-control input-sm" id="Keyword" placeholder="Search by Name" autocomplete="off">
                </div>
                </div>
                <div class="form-group col-md-3 mb-2">
                <button type="button" id="btn-search" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i>Search
                </button>
                </div>
                </div> *@

                <!-- Default Table -->
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Contact Number</th>
                            <th scope="col">Contact Email</th>
                            <th scope="col">Contact Address</th>
                            <th scope="col">Facebook</th>
                            <th scope="col">Instagram</th>
                            <th scope="col">Twitter</th>
                            <th scope="col">Youtube</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var i in Model)
                            {
                                <tr>
                                    <th scope="row">@i.Id</th>
                                    <td>@i.ContactNumber</td>
                                    <td>@i.ContactEmail</td>
                                    <td>@i.ContactAddress</td>
                                    <td>@i.FacebookLink</td>
                                    <td>@i.InstagramLink</td>
                                    <td>@i.TwitterLink</td>
                                    <td>@i.YoutubeLink</td>
                                </tr>
                            }

                        }
                        else
                        {
                            <tr>
                                <th colspan="8" class="text-center" scope="row">No record found</th>
                            </tr>
                        }

                    </tbody>
                </table>
                <!-- End Default Table Example -->

            </div>
        </div>
    </div>
</section>