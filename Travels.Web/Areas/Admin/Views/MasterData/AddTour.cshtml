@using Travels.Models.Master.DataTransferObjects
@model TourTypeDTO 

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    if(Model.Id ==0)
    {
        Model.IsPublished = true;
        Model.IsActive = true;
        ViewData["Title"] = "Add Tour";
    }
    else
        ViewData["Title"] = "Edit Tour";


}

<div class="row page-titles">
    <div class="col-md-5 col-12 align-self-center">
        <h3 class="text-themecolor mb-0">Add Agents</h3>
        <ol class="breadcrumb mb-0 p-0 bg-transparent">
            <li class="breadcrumb-item"> <a href="/Admin">Dashboard</a> </li>
            <li class="breadcrumb-item"> <a href="/Admin/MasterData">Master Data -  Tour types</a> </li>
            <li class="breadcrumb-item active">Create</li>
        </ol>
    </div>
</div>

<br />

<div class="row">
    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">

                <form asp-action="SaveAgents" asp-controller="Contact" method="post" id="AddTourTypesForm" enctype="multipart/form-data">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Id" class="form-control" />
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Name</label>
                            <input type="text" asp-for="Name" class="form-control" placeholder="Tour Name">
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6">
                            <label for="inputText" class="col-sm-6 col-form-label">Tour description</label>
                            <input type="text" asp-for="Description" class="form-control" placeholder="description">
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>                        


                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive">
                                <label class="form-check-label" asp-for="IsActive">
                                    Active
                                </label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublished">
                                <label class="form-check-label" asp-for="IsPublished">
                                    Published
                                </label>
                            </div>
                        </div>



                    </div>

                    <div class="pt-3">
                        <button type="submit" class="btn btn-primary">Submit</button>

                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/pagescripts/admin/masterdata/tourtype.js"></script>
    <script>
        var cd = new CreateTours();
        cd.init();
    </script>
}
