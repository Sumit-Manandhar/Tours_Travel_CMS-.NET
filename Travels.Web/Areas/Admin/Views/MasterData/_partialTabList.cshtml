@using Travels.Utility.Enumerations
@model int
@{
    Layout = null;
    var selected = (MasterDataTabMenu)Model;
    var detailUrl = Url.Action("Index", "MasterData", new { });
    var ClassOptionUrl = Url.Action("ClassOption", "MasterData", new { });
}

<ul class="nav nav-tabs pt-3" id="mdataTab" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == MasterDataTabMenu.TourType ? "active" : "")" id="tour-tab" data-bs-target="#Tourtab" aria-controls="Detail"
           href="@detailUrl" @(selected == MasterDataTabMenu.TourType ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Tour Type
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(selected == MasterDataTabMenu.ClassOption ? "active" : "")" id="ClassOption-tab" data-bs-target="#ClassOptionTab" aria-controls="Detail"
           href="@ClassOptionUrl" @(selected == MasterDataTabMenu.ClassOption ? "data-bs-toggle=tab aria-selected=\"true\"" : "")>
            Class Option
        </a>
    </li>
</ul>