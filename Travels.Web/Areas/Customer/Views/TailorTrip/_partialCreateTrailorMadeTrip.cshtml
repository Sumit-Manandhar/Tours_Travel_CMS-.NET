@using Travels.DataAccess.Repository.Common.Interface
@using Travels.Models.TailorTrip.DataTransferObjects
@model TailorTripCreateModel
@inject IUtilityService _utilities
@{
    var membercount = await _utilities.GetMembercount(false);
    var salurations = await _utilities.GetSalutation();
}

<form asp-action="Create" asp-controller="TailorTrip" method="post" id="createtailorTripForm" class="step-2s form-container">
    <div class="title-head">Package Requirements</div>
    <div class="box-shadow">
        <div class="row">
            <div class="col-md-6">
                <label>Preffered Travel Date *</label>
                <input type="text" asp-for="TravelDate" placeholder="Select date"
                       class="form-control tour-listing-details__sidebar-form-date vietjet-datepicker">
                <i class="tour-listing-details__sidebar-form-date-arrow fas fa-angle-down"></i>
                @Html.ValidationMessageFor(x => x.TravelDate)
            </div>
            <div class="col-md-6">
                <label>Length of travel (in Days) *</label>
                <input type="number" asp-for="Length" class="form-control" placeholder="Length of travel">
            </div>
            <div class="col-md-6">
                <label>Destination *</label>
                @Html.DropDownListFor(model => model.CountryId, new SelectList(Model.Countries, "Id", "CountryName"),
                                  new { @class = "form-select mr-sm-2  select2init" })
                @Html.ValidationMessageFor(model => model.CountryId, "", new { @class = "text-danger" })
            </div>
             <div class="col-md-6">
                            <label>City :</label>
                @Html.DropDownListFor(model => model.CityId, new SelectList(Model.Countries, "Id", "CountryName"),
                                  new { @class = "form-select mr-sm-2 select2init" })
                @Html.ValidationMessageFor(model => model.CityId, "", new { @class = "text-danger" })

                        </div>
            <div class="col-md-6">
                <div class="">
                    <label>Hotel Category *</label>
@*                     <input type="text" asp-for="HotelCategory" class="form-control" placeholder="Hotel Category">
 *@                    <select asp-for="HotelCategory" class="form-control">
                        <option value=" " disabled>Select hotel Category</option>
                        <option value="3*">3*</option>
                        <option value="4*">4* </option>
                        <option value="5*">5*</option>
                        <option value="Not applicable">Not applicable</option>
                    </select>
                    @Html.ValidationMessageFor(model => model.HotelCategory, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <label>Activity *</label>
                <input type="text" asp-for="Activity" class="form-control" placeholder="Activity">
                @Html.ValidationMessageFor(model => model.Activity, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-12">
                <div class="row">
                    <div class="col-sm-4">
                        <div class="">
                            <label>No. of Adult (above 12)*</label>
                            @Html.DropDownListFor(model => model.Adult, await _utilities.GetMembercount(true), new { @class = "form-select mr-sm-2" })
                            @Html.ValidationMessageFor(model => model.Adult, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="">
                            <label>No. of Children (2 - 12)</label>
                            @Html.DropDownListFor(model => model.Child, membercount, new { @class = "form-select mr-sm-2" })
                            @Html.ValidationMessageFor(model => model.Child, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="mb-3">
                            <label>No. of Infant (below 2 )</label>
                            @Html.DropDownListFor(model => model.Infant, membercount, new { @class = "form-select mr-sm-2" })
                            @Html.ValidationMessageFor(model => model.Infant, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="title-head">Personal Details</div>
    <div class="box-shadow">

        <div class="row">

            <div class="col-md-2">
                <div class="">
                    <label>Salutations *</label>
                    @Html.DropDownListFor(model => model.PersonalDetail.Salutation, salurations, new { @class = "form-select mr-sm-2" })
                    @Html.ValidationMessageFor(model => model.PersonalDetail.Salutation, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-5">
                <div class="">
                    <label>First Name *</label>
                    <input type="text" asp-for="PersonalDetail.FirstName" class="form-control" placeholder="First Name">
                    @Html.ValidationMessageFor(model => model.PersonalDetail.FirstName, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="col-md-5">
                <div class="">
                    <label>Last Name *</label>
                    <input type="text" asp-for="PersonalDetail.LastName" class="form-control" placeholder="Last Name">
                    @Html.ValidationMessageFor(model => model.PersonalDetail.LastName, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="">
                    <label>Nationality *</label>
                    @Html.DropDownListFor(model => model.PersonalDetail.CountryId, new SelectList(Model.Countries, "Id", "CountryName"),
                             new { @class = "form-select mr-sm-2" })
                    @Html.ValidationMessageFor(model => model.PersonalDetail.CountryId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="">
                    <label>Email Address *</label>
                    <input type="email" asp-for="PersonalDetail.Email" class="form-control" placeholder="Email Address">
                    @Html.ValidationMessageFor(model => model.PersonalDetail.Email, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="col-md-6">
                <div class="">
                    <label>Contact Number</label>
                    <br />
                    <input type="text" asp-for="PersonalDetail.PhoneNumber" class="form-control" placeholder="Contact Number">
                    <input hidden name="ContactPhoneCode" id="ContactPhoneCode"  />
                    <p id="error-msg" class="error hide text-danger"></p>
                    @Html.ValidationMessageFor(model => model.PersonalDetail.PhoneNumber, "", new { @class = "text-danger" })

                </div>
            </div>
            <div class="col-md-12">
                <div class="">
                    <label>Special Request *</label>
                    <textarea type="textarea" asp-for="PersonalDetail.SpecialRequest" class="form-control" placeholder=""></textarea>
                    @Html.ValidationMessageFor(model => model.PersonalDetail.SpecialRequest, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <div class="login-page__btn-box d-flex justify-content-flex-start column-gap-10 mt-40">
        <button type="button" class="vietjet-btn vietjet-btn--base" id="submitTailorMadeButton"><span>Request now</span></button>
    </div>

</form>
