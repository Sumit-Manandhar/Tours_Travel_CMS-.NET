@using Travels.Models.ViewModels;
@model SubdestinationDetailsModel

@{
    ViewData["Title"] = "Detail";
    var bannerImage = Model.Images.Where(x => x.IsBanner).FirstOrDefault();
}

<section class="page-header">
    <div class="page-header__bg" style="background-image: url(@("/"+bannerImage?.ImageUrl));"></div>
    <div class="container">
        <h2 class="page-header__title wow animated fadeInLeft" data-wow-delay="0s" data-wow-duration="1500ms">
            Visit attractions in @Model.Name- @Model.DestinationName
        </h2>
        <div class="page-header__breadcrumb-box">
            <ul class="vietjet-breadcrumb">
                <li><a href="/">Home</a></li>
                <li><a href="@Url.Action("GetDetails","Destination", new{Area="Customer", @id=Model.DestinationId})">@(Model.DestinationName??"")</a></li>
                <li>@Model.Name</li>
            </ul>
        </div>
    </div>
</section>


<section class="destination-details mt-80">

    <div class="container">
        <div class="row">
            <div class="col-xl-12">

                <div class="tour-listing-details__explore" style="text-align: justify;">
                    <div class="wow animated fadeIn" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <h3 class="tour-listing-details__title tour-listing-details__explore-title">Explore Tours</h3>
                    </div>
                    <p class="tour-listing-details__explore-text wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        @Html.Raw(Model.Description)
                    </p>
                </div>
                <div class="tour-listing-details__included" style="text-align: justify;">
                    <h3 class="tour-listing-details__title tour-listing-details__included-title">Top Destinations</h3>
                    <div class="row">
                        <div class="col-lg-6 col-md-7 wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            @Html.Raw(Model.TopDestination)
                        </div>

                    </div>
                </div>

                <div class="row">
                    @foreach (var img in Model.Images.Where(x => !x.IsBanner && !x.IsPrimary))
                    {
                        var imgURL = "/" + img.ImageUrl;
                        <div class="col-xl-4 col-lg-4 col-sm-6 wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                            <div class="gallery-single">
                                <div class="gallery-single__img-box">
                                    <img src="@imgURL" alt="gallery" class="gallery-single__img">
                                    <div class="gallery-single__overlay">
                                        <a href="@imgURL" class="gallery-single__btn vietjet-btn vietjet-btn--base-three img-popup">
                                            <span class="icon-plus"></span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (Model.OtherDestinations != null && Model.OtherDestinations.Any())
            {
                <div class="col-md-12 mt-80">
                    <div class="tour-listing-details__similar container-fluid" style="border-top:1px solid #EBE6DE; padding-top: 20px;">
                        <h3 class="tour-listing-details__title tour-listing-details__similar-title">Similar Destinations</h3>
                        <div class="destination-page-two__carousel vietjet-owl__carousel vietjet-owl__carousel--basic-nav owl-theme owl-carousel" data-owl-options='{
                             "items" : 4,
                             "margin" : 30,
                             "smartSpeed" : 700,
                             "loop" :false,
                             "autoplay" : 6000,
                             "nav" :false,
                             "dots" :true,
                             "navText" : ["<span class=\"fa fa-angle-left\"></span>","<span class=\"fa fa-angle-right\"></span>"],
                                                        "responsive":{
                                                            "0":{
                                                                "items": 1
                                                            },
                                                            "768":{
                                                                "items": 2
                                                            },
                                                            "992":{
                                                                "items": 3
                                                            },
                                                            "1200":{
                                                                "items": 4
                                                            }
                                                        }
                                                        }'>
                            @foreach (var dest in Model.OtherDestinations)
                            {
                                var detailUrl = @Url.Action("Detail", "Destination", new { Area = "Customer", @id = dest.Id });
                                <div class="destination-page-two__carousel-item item">
                                    <div class="destination-two__card">
                                        <div class="destination-two__card-img-box destination-two__card-img-box--round">
                                                                            <img src="@("/"+dest.ImageURL)" alt="destination" style="aspect-ratio:3/2 !important;" class="destination-two__card-img destination-two__card-img--round">
                                            <div class="destination-two__card-overlay destination-two__card-overlay--round">
                                                        <a href="@detailUrl" class="destination-two__card-plus"><span class="icon-right-arrow"></span></a>
                                            </div>
                                            <div class="destination-two__card-btn">
                                                        <a href="@detailUrl" class="vietjet-btn vietjet-btn--base-three"><span>@dest.Name
                                                </span></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</section>
