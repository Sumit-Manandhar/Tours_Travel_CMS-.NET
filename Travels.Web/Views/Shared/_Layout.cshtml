@using Microsoft.AspNetCore.Http
@using Travels.DataAccess.Repository.IRepository
@inject IHttpContextAccessor HttpContextAccessor
@inject IUnitOfWork _uow
@{
    var contact = _uow.Contacts.GetAll().FirstOrDefault(a => a.IsActive && a.IsPublished && !a.IsDeleted);
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vietjet Holidays | @ViewData["Title"]</title>
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/images/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon.ico" />
    @* <link rel="manifest" href="assets/images/favicons/site.webmanifest" /> *@
    <meta name="description" content="Vietjet Holidays" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Satisfy&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,700;0,800;1,800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Manrope&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="~/assets/vendors/vietjet-icons/style.css" />
    <link rel="stylesheet" href="~/assets/vendors/owl-carousel/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/assets/vendors/owl-carousel/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/assets/vendors/daterangepicker-master/daterangepicker.css" />

    <link rel="stylesheet" href="~/assets/css/style.css" />
    @await RenderSectionAsync("Styles", required: false)

</head>

<body>
    <div class="preloader">
        <div class="preloader__image" style="background-image: url(/assets/images/preloader.gif);"></div>
    </div>
    <div class="page-wrapper">
        <header class="main-header sticky-header sticky-header--one-page">
            <div class="container">
                <div class="main-header__inner">
                    <div class="main-header__left">
                        <div class="main-header__logo">
                            <a href="/">
                                <img src="~/assets/images/logo.svg" alt="Vietjet Holidays" width="146">
                            </a>
                        </div>
                        <nav class="main-header__nav main-menu">
                            <ul class="main-menu__list one-page-scroll-menu">
                                <li class="dropdown">
                                    <a href="javascript:void(0)">Destinations</a>
                                    <ul class="sub-menu">
                                        @* <li><a href="vietnam.html">Vietnam</a></li>
                                        <li><a href="singapore.html">Singapore</a></li> *@
                                        @if (_uow.Destination.GetAll().Where(a=>a.IsActive && a.IsPublished && !a.IsDeleted).Any())
                                        {
                                            foreach (var i in _uow.Destination.GetAll().Where(a => a.IsActive && a.IsPublished && !a.IsDeleted).ToList())
                                            {
                                                <li><a href="~/customer/destination/GetDetails?id=@i.Id">@i.Name.Trim()</a></li>
                                            }
                                        }
                                    </ul>
                                </li>
                                <li><a href="/Customer/Package">Packages</a></li>
                                <li><a href="@Url.Action("Group", "Package", new { Area = "Customer" })">Group Departure</a></li>
                                <li><a href="@Url.Action("Index", "TailorTrip", new { Area = "Customer" })">Tailor Made Trip</a></li>
                                <li><a href="@Url.Action("Contact", "Home", new { Area = "Customer" })">Contact</a></li>
                            </ul>
                        </nav>

                        <a href="@Url.Action("Index", "Vendor", new { Area = "Customer" })" class="main-header__button vietjet-btn vietjet-btn--two vietjet-btn--base register-btn">
                            <span>Vendor Registration</span>
                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    </div>

                    <div class="main-header__right">
                        <div class="mobile-nav__btn mobile-nav__toggler">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <div class="main-header__right-right">
                            <div class="main-header__phone">
                                <!-- <div class="main-header__phone-icon">
                                    <span class="icon-phone-1"></span>
                                </div> -->
                                <div class="main-header__phone-text">
                                    <p class="main-header__phone-title"><i class="fa-brands fa-whatsapp"></i> <a href="https://wa.me/@contact?.ContactNumber" target="_blank">@contact?.ContactNumber</a> </p>
                                    <p class="main-header__phone-title">
                                        <i class="fa-regular fa-envelope"></i> <a href="mailto:@contact?.ContactEmail">
                                            @contact?.ContactEmail
                                        </a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="main-footer">
            <div class="container">
              
                <div class="row gutter-y-40">
                    <div class="col-lg-3 wow animated fadeInUp" data-wow-delay="0.1s" data-wow-duration="1500ms">
                        <div class="footer-widget footer-widget--links">
                            <h2 class="footer-widget__title">Company</h2>
                            <!-- /.footer-widget__title -->
                            <ul class="footer-widget__links">
                                <li><a href="javascript:void(0)">About Us</a></li>
                                <li><a href="javascript:void(0)">Why Choose Us</a></li>
                                <li><a href="javascript:void(0)">Gallery</a></li>
                                <li><a href="javascript:void(0)">Our Blog</a></li>
                                <li><a href="@Url.Action("Contact", "Home", new { Area = "Customer" })">Contact Now</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 wow animated fadeInUp" data-wow-delay="0.3s" data-wow-duration="1500ms">
                        <div class="footer-widget footer-widget--links">
                            <h2 class="footer-widget__title">Explore</h2>
                            <ul class="footer-widget__links">
                                <li><a href="javascript:void(0)">Destinations</a></li>
                                <li><a href="/Customer/Package">Tour Packages</a></li>
                                <li><a href="javascript:void(0)">Privacy Policy</a></li>
                                <li><a href="javascript:void(0)">Terms & Conditions</a></li>
                                <li><a href="javascript:void(0)">FAQ</a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 wow animated fadeInUp" data-wow-delay="0.5s" data-wow-duration="1500ms">
                        <div class="footer-widget footer-widget--contact">
                            <h2 class="footer-widget__title">Contact</h2>
                            <!-- <p class="footer-widget__address">6391 Elgin St. Celina, Delaware New York. USA</p> -->
                            <p>Chat with us on WhatsApp :</p>
                            <ul class="footer-widget__info">
                                <li>

                                    <i class="fa-brands fa-whatsapp"></i><span>
                                        <a href="@("https://wa.me/ "+@contact?.ContactNumber)" target="_blank">@contact?.ContactNumber</a>
                                    </span>
                                </li>
                                <li>
                                    <i class="fa fa-envelope"></i>
                                    <a href="@("mailto:"+ contact?.ContactEmail)">
                                        @contact?.ContactEmail
                                    </a>
                                </li>
                                <li>

                                    <i class="fa-solid fa-location-dot"></i>
                                    <span>@contact?.ContactAddress</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 wow animated fadeInUp" data-wow-delay="0.7s" data-wow-duration="1500ms">
                        <div class="footer-widget footer-widget--newsletter">
                            <h2 class="footer-widget__title">Follow us on</h2>
                            <ul class="main-footer__social">
                                <li class="main-footer__social-item">
                                    <a href="@contact?.FacebookLink" target="_blank" class="main-footer__social-link"><i class="fab fa-facebook-f"></i></a>
                                </li>
                                <li class="main-footer__social-item">
                                    <a href="@contact?.InstagramLink" target="_blank"  class="main-footer__social-link">
                                        <i class="fab fa-instagram"></i>
                                    </a>
                                </li>
                                <li class="main-footer__social-item">
                                    <a href="@contact?.TwitterLink" target="_blank" class="main-footer__social-link"><i class="fab fa-twitter"></i></a>
                                </li>
                                <li class="main-footer__social-item">
                                    <a href="@contact?.YoutubeLink" target="_blank" class="main-footer__social-link"><i class="fab fa-youtube"></i></a>
                                </li>
                            </ul>
                        </div>


                    </div>

                </div>

            </div>

            <div class="main-footer__bottom">
                <div class="container">
                    <div class="main-footer__bottom-inner">
                        <p class="main-footer__copyright">
                            &copy; Copyright <span class="dynamic-year"></span> by Vietjetholidays.com
                        </p>
                    </div>

                </div>

            </div>

        </footer>
    </div>

    <div class="mobile-nav__wrapper">
        <div class="mobile-nav__overlay mobile-nav__toggler"></div>

        <div class="mobile-nav__content">
            <span class="mobile-nav__close mobile-nav__toggler"><i class="fa fa-times"></i></span>

            <div class="logo-box">
                <a href="~/" aria-label="logo image"><img src="~/assets/images/logo.svg" width="155" alt="" /></a>
            </div>
            <div class="mobile-nav__container"></div>

            <ul class="mobile-nav__contact list-unstyled">
                <li>
                    <i class="fa fa-envelope"></i>
                    <a href="mailto:info@vietjetholidays.com">info@vietjetholidays.com</a>
                </li>
                <li>
                    <i class="fa fa-phone-alt"></i>
                    <a href="tel:(303)5550105">(303) 555-0105</a>
                </li>
            </ul>
            <div class="mobile-nav__social">
                <a href="javascript:void(0)">
                    <i class="fab fa-twitter" aria-hidden="true"></i>
                    <span class="sr-only">Twitter</span>
                </a>
                <a href="javascript:void(0)">
                    <i class="fab fa-facebook" aria-hidden="true"></i>
                    <span class="sr-only">Facebook</span>
                </a>
                <a href="javascript:void(0)">
                    <i class="fab fa-pinterest-p" aria-hidden="true"></i>
                    <span class="sr-only">Pinterest</span>
                </a>
                <a href="javascript:void(0)">
                    <i class="fab fa-instagram" aria-hidden="true"></i>
                    <span class="sr-only">Instagram</span>
                </a>
            </div>
        </div>
    </div>

    <a href="#" data-target="html" class="scroll-to-target scroll-to-top">
        <span class="scroll-to-top__text">back top</span>
        <span class="scroll-to-top__wrapper"><span class="scroll-to-top__inner"></span></span>
    </a>

    <script src="~/assets/vendors/jquery/jquery-3.7.0.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script src="~/assets/vendors/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendors/jquery-appear/jquery.appear.min.js"></script>
    <!-- <script src="assets/vendors/jquery-ui/jquery-ui.js"></script> -->
    <script src="~/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.min.js"></script>
    <script src="~/assets/vendors/owl-carousel/js/owl.carousel.min.js"></script>
    <script src="~/assets/vendors/owl-carousel/js/owlcarousel2-filter.min.js"></script>
    <script src="~/assets/vendors/wow/wow.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script src="~/assets/vendors/simpleParallax/simpleParallax.min.js"></script>
    <script src="~/assets/vendors/imagesloaded/imagesloaded.min.js"></script>
    @* <script src="~/assets/vendors/isotope/isotope.js"></script> *@
    @* <script src="~/assets/vendors/countdown/countdown.min.js"></script> *@
    <script src="~/assets/vendors/daterangepicker-master/moment.min.js"></script>
    <script src="~/assets/vendors/daterangepicker-master/daterangepicker.js"></script>
    <script src="~/lib/lazyload.min.js"></script>
    <script src="~/pagescripts/common/shared.js"></script>
    <script src="~/assets/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


